<section class="mm-home mm-timeline" id="mm-{{ section.id }}">
  <div class="mm-pad">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="mm-section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="mm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}<p class="mm-section-text">{{ section.settings.text | escape | newline_to_br }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <mm-timeline class="mm-timeline__list">
      <span class="mm-timeline__line" aria-hidden="true"><span></span></span>
      {%- for block in section.blocks -%}
        {%- assign step_symbol = block.settings.character -%}
        {%- liquid
  case step_symbol
    when 'showoff'
      assign step_colour = '#1E6448'
    when 'player'
      assign step_colour = '#F37400'
    when 'trickster'
      assign step_colour = '#4CA7FF'
    when 'helper'
      assign step_colour = '#FF6EA7'
    else
      assign step_colour = 'currentColor'
  endcase
-%}
        <article class="mm-timeline__item" style="--mm-char: {{ step_colour }};" {{ block.shopify_attributes }}>
          <span class="mm-timeline__dot" aria-hidden="true">
            {%- if step_symbol != 'none' -%}<span class="mm-symbol-mask " style="--mm-symbol-url: url({{ 'mm-symbol-' | append: step_symbol | append: '.svg' | asset_url }}); --mm-symbol-color: var(--mm-char);" aria-hidden="true"></span>{%- endif -%}
          </span>
          <div class="mm-timeline__card">
            {%- if block.settings.label != blank -%}<p class="mm-timeline__label">{{ block.settings.label | escape }}</p>{%- endif -%}
            <h3 class="mm-display">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="mm-timeline__text">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.image != blank -%}
              <div class="mm-timeline__image">{{ block.settings.image | image_url: width: 900 | image_tag: alt: block.settings.image.alt, loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 750px) 40vw, 90vw' }}</div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </mm-timeline>
  </div>
</section>

{%- capture mm_section_css -%}{% render 'mm-section-style', settings: section.settings, id: section.id %}{%- endcapture -%}
{% style %}{{ mm_section_css }}{% endstyle %}

{% style %}
#mm-{{ section.id }} .mm-timeline__list{--mm-timeline-line:{{ section.settings.line_colour }};--mm-timeline-card:{{ section.settings.card_background }}}
{% endstyle %}

{% stylesheet %}
.mm-timeline__list{position:relative;display:grid;gap:clamp(28px,4vw,56px);padding:12px 0}
.mm-timeline__line{position:absolute;top:0;bottom:0;left:50%;width:2px;translate:-50% 0;background:color-mix(in srgb,var(--mm-ink) 12%,transparent)}
.mm-timeline__line span{display:block;width:100%;height:calc(var(--mm-timeline-progress,0) * 100%);background:var(--mm-timeline-line,var(--mm-accent))}
.mm-timeline__item{position:relative;display:grid;grid-template-columns:1fr 1fr;align-items:center}
.mm-timeline__card{grid-column:1;justify-self:end;width:min(100%,460px);margin-right:56px;display:grid;gap:10px;padding:26px;border-radius:20px;background:var(--mm-timeline-card);opacity:0;translate:-24px 0;transition:opacity .6s ease,translate .8s cubic-bezier(.22,1,.36,1)}
.mm-timeline__item:nth-child(odd) .mm-timeline__card{grid-column:2;justify-self:start;margin:0 0 0 56px;translate:24px 0}
.mm-timeline__item.is-visible .mm-timeline__card{opacity:1;translate:0 0}
.mm-timeline__dot{position:absolute;left:50%;top:50%;translate:-50% -50%;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--mm-paper);border:2px solid color-mix(in srgb,var(--mm-ink) 14%,transparent);transition:border-color .4s}
.mm-timeline__dot .mm-symbol-mask{width:24px;background-color:var(--mm-ink)!important;scale:.6;transition:scale .6s cubic-bezier(.34,1.56,.64,1),background-color .4s,rotate .8s cubic-bezier(.34,1.56,.64,1)}
.mm-timeline__item.is-visible .mm-timeline__dot{border-color:var(--mm-char)}
.mm-timeline__item.is-visible .mm-timeline__dot .mm-symbol-mask{scale:1;background-color:var(--mm-char)!important;rotate:90deg}
.mm-timeline__label{font-size:12px;font-weight:700;letter-spacing:.16em;color:var(--mm-char)}
.mm-timeline__card h3{font-size:clamp(22px,2vw,30px);line-height:1.1}
.mm-timeline__text{font-size:15px;line-height:1.55;opacity:.8}
.mm-timeline__text p{margin:0}
.mm-timeline__image{margin-top:6px;border-radius:12px;overflow:hidden;aspect-ratio:16/10}
.mm-timeline__image img{width:100%;height:100%;object-fit:cover;display:block}
.mm-symbol-mask{display:block;aspect-ratio:1;background-color:var(--mm-symbol-color,currentColor);-webkit-mask:var(--mm-symbol-url) center/contain no-repeat;mask:var(--mm-symbol-url) center/contain no-repeat}
@media(max-width:749px){
  .mm-timeline__line{left:22px}
  .mm-timeline__item{grid-template-columns:1fr}
  .mm-timeline__card,.mm-timeline__item:nth-child(odd) .mm-timeline__card{grid-column:1;justify-self:stretch;width:auto;margin:0 0 0 58px;translate:0 16px}
  .mm-timeline__dot{left:22px;top:28px}
}
@media(prefers-reduced-motion:reduce){.mm-timeline__card{opacity:1;translate:none;transition:none}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('mm-timeline')) {
  customElements.define(
    'mm-timeline',
    class MMTimeline extends HTMLElement {
      connectedCallback() {
        const items = [...this.querySelectorAll('.mm-timeline__item')];
        if (!('IntersectionObserver' in window) || window.Shopify?.designMode) {
          for (const item of items) item.classList.add('is-visible');
        } else {
          this.observer = new IntersectionObserver((entries) => {
            for (const entry of entries) if (entry.isIntersecting) entry.target.classList.add('is-visible');
          }, { rootMargin: '0px 0px -15% 0px' });
          for (const item of items) this.observer.observe(item);
        }
        this.onScroll = () => {
          const rect = this.getBoundingClientRect();
          const progress = (window.innerHeight * 0.6 - rect.top) / rect.height;
          this.style.setProperty('--mm-timeline-progress', String(Math.max(0, Math.min(1, progress))));
        };
        this.onScroll();
        window.addEventListener('scroll', this.onScroll, { passive: true });
        document.querySelector('.page-wrapper')?.addEventListener('scroll', this.onScroll, { passive: true });
      }

      disconnectedCallback() {
        this.observer?.disconnect();
        window.removeEventListener('scroll', this.onScroll);
        document.querySelector('.page-wrapper')?.removeEventListener('scroll', this.onScroll);
      }
    }
  );
}
{% endjavascript %}

{% schema %}
{
  "name": "MM · Timeline",
  "tag": "div",
  "class": "mm-timeline-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Our story"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "How it all\nmish-mashed."
    },
    {
      "type": "header",
      "content": "Timeline"
    },
    {
      "type": "color",
      "id": "line_colour",
      "label": "Line colour",
      "default": "#FF6EA7"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card colour",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "cocogoose",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "proxima",
          "label": "Proxima Nova"
        },
        {
          "value": "cocogoose",
          "label": "Cocogoose Regular"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Mobile heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#171514"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent colour",
      "default": "#FF6EA7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "2024"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The first sketch"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "character",
          "label": "Symbol on the line",
          "default": "showoff",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "showoff",
              "label": "The Show-off"
            },
            {
              "value": "player",
              "label": "The Player"
            },
            {
              "value": "trickster",
              "label": "The Trickster"
            },
            {
              "value": "helper",
              "label": "The Helper"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM · Timeline",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "The idea",
            "title": "A vase with an attitude",
            "text": "<p>It started with one question: why do everyday objects have to be so serious?</p>",
            "character": "showoff"
