        {
          "type": "character",
          "settings": {
            "character": "player",
            "text": "Bright colours and parts you can swap around."
          }
        },
        {
          "type": "character",
          "settings": {
            "character": "trickster",
            "text": "A small twist that surprises every time."
          }
        },
        {
          "type": "character",
          "settings": {
            "character": "helper",
            "text": "Soft colours, smart details, always useful."
          }
