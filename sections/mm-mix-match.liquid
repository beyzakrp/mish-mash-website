  "presets": [
    {
      "name": "MM · Mix & Match Studio",
      "blocks": [
        {
          "type": "object",
          "settings": {
            "name": "Vase"
          }
        },
        {
          "type": "object",
          "settings": {
            "name": "Lamp"
          }
        },
        {
          "type": "object",
          "settings": {
            "name": "Clock"
          }
        },
        {
          "type": "object",
          "settings": {
            "name": "Candle"
          }
        },
        {
          "type": "character",
          "settings": {
            "character": "showoff",
            "text": "Bold, sculptural and made to be looked at."
          }
