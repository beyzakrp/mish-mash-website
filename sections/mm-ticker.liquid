      "id": "font_size",
      "label": "Text size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll duration",
      "info": "Seconds for one full loop. Higher is slower.",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 34
    },
    {
      "type": "select",
      "id": "direction",
