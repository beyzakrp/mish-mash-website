<section class="mm-home" id="mm-{{ section.id }}">
<div class="mm-ticker{% if section.settings.edge_fade %} mm-ticker--fade{% endif %}" data-mm-ticker style="--mm-ticker-duration:{{ section.settings.duration }}s;--mm-ticker-fade:{{ section.settings.edge_fade_width }}vw">
  <div class="mm-ticker-track{% if section.settings.direction == 'right' %} mm-ticker-track--reverse{% endif %}">
    {% for i in (1..2) %}<div class="mm-ticker-group"{% if i == 2 %} aria-hidden="true"{% endif %}>{% for block in section.blocks %}{% if block.type == 'symbol' %}<span class="mm-ticker-symbol mm-ticker-symbol--{{ block.settings.colour }}"{% if i == 1 %} {{ block.shopify_attributes }}{% endif %}><img src="{{ 'mm-symbol-' | append: block.settings.character | append: '.svg' | asset_url }}" alt="" width="70" height="77" loading="lazy"></span>{% else %}<span{% if i == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}</span>{% endif %}{% endfor %}</div>{% endfor %}
  </div>
  <button type="button" class="mm-ticker-toggle" aria-pressed="false" aria-label="{{ 'mishmash.pause_motion' | t }}" data-mm-ticker-toggle>
    <span class="mm-ticker-toggle__pause" aria-hidden="true">❚❚</span><span class="mm-ticker-toggle__play" aria-hidden="true">▶</span>
  </button>
</div>
</section>

{% style %}
#mm-{{ section.id }}{--mm-paper:{{ section.settings.background }};--mm-ink:{{ section.settings.text_color }};background:var(--mm-paper);color:var(--mm-ink)}
{% endstyle %}
{% style %}#mm-{{ section.id }} .mm-ticker{background:{{ section.settings.background }};height:{{ section.settings.height }}px;font-size:{{ section.settings.font_size }}px}#mm-{{ section.id }} .mm-ticker span{font-size:inherit}{% endstyle %}
{% schema %}
{
  "name": "MM · Text strip",
  "settings": [
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade text at the edges",
      "default": true
    },
    {
      "type": "range",
      "id": "edge_fade_width",
      "label": "Edge fade width",
      "min": 4,
      "max": 25,
      "step": 1,
      "unit": "%",
      "default": 12
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FF6EA7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#171514"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 30,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 78
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll duration",
      "info": "Seconds for one full loop. Higher is slower.",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 34
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM · Text strip",
      "blocks": [
        {
          "type": "word",
          "settings": {
            "text": "mish."
          }
        },
        {
          "type": "symbol",
          "settings": {
            "character": "showoff",
            "colour": "ink"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "mash."
          }
        },
        {
          "type": "symbol",
          "settings": {
            "character": "player",
            "colour": "ink"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "mish."
          }
        },
        {
          "type": "symbol",
          "settings": {
            "character": "trickster",
            "colour": "ink"
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "mash."
          }
        },
        {
          "type": "symbol",
          "settings": {
            "character": "helper",
            "colour": "ink"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Text or symbol",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "mish."
        }
      ]
    },
    {
      "type": "symbol",
      "name": "Personality symbol",
      "settings": [
        {
          "type": "select",
          "id": "character",
          "label": "Symbol",
          "default": "showoff",
          "options": [
            {
              "value": "showoff",
              "label": "The Show-off"
            },
            {
              "value": "player",
              "label": "The Player"
            },
            {
              "value": "trickster",
              "label": "The Trickster"
            },
            {
              "value": "helper",
              "label": "The Helper"
            }
          ]
        },
        {
          "type": "select",
          "id": "colour",
          "label": "Colour",
          "default": "ink",
          "options": [
            {
              "value": "ink",
              "label": "Text colour"
            },
            {
              "value": "brand",
              "label": "Brand colour"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 16
}
{% endschema %}
