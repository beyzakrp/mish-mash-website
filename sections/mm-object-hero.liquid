{%- liquid
  assign object_collection = collection
  assign object_image = section.settings.image | default: object_collection.image
  assign object_name = section.settings.name
  if object_name == blank
    assign object_name = object_collection.title | default: 'Clock'
  endif
  assign object_text = section.settings.text
  if section.settings.text_source == 'description' and object_collection.description != blank
    assign object_text = object_collection.description
  endif
  assign object_count = object_collection.products_count | default: 0
  assign badge_text = section.settings.badge_text | default: object_name | append: ' · mish-mash · ' | upcase
-%}
<section class="mm-home mm-ohero mm-ohero--media-{{ section.settings.media_side }}" id="mm-{{ section.id }}">
  {%- if section.settings.show_outline -%}
    <div class="mm-ohero__outline" aria-hidden="true">
      <div class="mm-ohero__outline-track">
        {%- for i in (1..6) -%}<span>{{ object_name | escape }}</span>{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  <div class="mm-pad mm-ohero__inner">
    <div class="mm-ohero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="mm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="mm-ohero__name mm-display">{{ object_name | escape }}</h1>
      {%- if object_text != blank -%}<div class="mm-ohero__text">{{ object_text }}</div>{%- endif -%}
      <div class="mm-ohero__meta">
        {%- if section.settings.show_count and object_count > 0 -%}
          <span class="mm-ohero__count"><strong>{{ object_count }}</strong> {{ section.settings.count_label | escape }}</span>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="mm-ohero__button" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label | escape }} {% render 'mm-icon', icon: 'arrow-down' %}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.show_characters -%}
        <ul class="mm-ohero__characters" role="list">
          {%- assign hero_characters = 'showoff,player,trickster,helper' | split: ',' -%}
          {%- for character in hero_characters -%}
            {%- liquid
              assign link_key = 'link_' | append: character
              assign character_link = section.settings[link_key]
              assign character_key = 'mishmash.' | append: character
              assign character_name = character_key | t
            -%}
            {%- liquid
  case character
    when 'showoff'
      assign character_colour = '#970C38'
    when 'player'
      assign character_colour = '#CCDB65'
    when 'trickster'
      assign character_colour = '#192FDA'
    when 'helper'
      assign character_colour = '#FB7FB0'
    else
      assign character_colour = 'currentColor'
  endcase
-%}
            <li style="--mm-char: {{ character_colour }};">
              <a href="{{ character_link | default: '#' }}" class="mm-ohero__chip"><span class="mm-symbol-mask" style="--mm-symbol-url: url({{ 'mm-symbol-' | append: character | append: '.svg' | asset_url }}); --mm-symbol-color: var(--mm-char);" aria-hidden="true"></span><span>{{ character_name | escape }}</span></a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="mm-ohero__media">
      <div class="mm-ohero__frame">
        {%- if object_image != blank -%}
          {{ object_image | image_url: width: 1800 | image_tag: alt: object_name, widths: '600,900,1200,1500,1800', sizes: '(min-width: 990px) 50vw, 100vw', fetchpriority: 'high', class: 'mm-ohero__image' }}
        {%- else -%}
          <img class="mm-ohero__image" src="{{ 'mm-reference-hero.webp' | asset_url }}" alt="" width="1600" height="1000" fetchpriority="high">
        {%- endif -%}
      </div>
      {%- case section.settings.image_detail -%}
        {%- when 'clock' -%}
          <mm-live-clock class="mm-ohero__accent mm-ohero__clock" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="48" class="mm-ohero__clock-face"/>
              {%- for i in (0..11) -%}<line x1="50" y1="6" x2="50" y2="{% if i == 0 or i == 3 or i == 6 or i == 9 %}14{% else %}11{% endif %}" transform="rotate({{ i | times: 30 }} 50 50)" class="mm-ohero__clock-tick"/>{%- endfor -%}
              <line x1="50" y1="50" x2="50" y2="27" class="mm-ohero__clock-hour" data-hand="hour"/>
              <line x1="50" y1="50" x2="50" y2="16" class="mm-ohero__clock-minute" data-hand="minute"/>
              <line x1="50" y1="58" x2="50" y2="12" class="mm-ohero__clock-second" data-hand="second"/>
              <circle cx="50" cy="50" r="3.2" class="mm-ohero__clock-pin"/>
            </svg>
          </mm-live-clock>
        {%- when 'symbol' -%}
          {%- assign symbol = section.settings.symbol -%}
          {%- liquid
  case symbol
    when 'showoff'
      assign symbol_colour = '#970C38'
    when 'player'
      assign symbol_colour = '#CCDB65'
    when 'trickster'
      assign symbol_colour = '#192FDA'
    when 'helper'
      assign symbol_colour = '#FB7FB0'
    else
      assign symbol_colour = 'currentColor'
  endcase
-%}
          <span class="mm-ohero__accent mm-ohero__symbol"><span class="mm-symbol-mask" style="--mm-symbol-url: url({{ 'mm-symbol-' | append: symbol | append: '.svg' | asset_url }}); --mm-symbol-color: {{ symbol_colour }};" aria-hidden="true"></span></span>
      {%- endcase -%}
      {%- if section.settings.show_badge -%}
        <div class="mm-ohero__badge" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs><path id="mm-ohero-circle-{{ section.id }}" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
            <text><textPath href="#mm-ohero-circle-{{ section.id }}" textLength="288">{{ badge_text | escape }}</textPath></text>
          </svg>
          <span class="mm-ohero__badge-count">{% if object_count > 0 %}{{ object_count }}{% else %}{% render 'mm-icon', icon: 'asterisk' %}{% endif %}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- capture mm_section_css -%}{% render 'mm-section-style', settings: section.settings, id: section.id %}{%- endcapture -%}
{% style %}{{ mm_section_css }}{% endstyle %}

{% style %}
#mm-{{ section.id }}{--mm-ohero-name:{{ section.settings.name_size }}px;--mm-ohero-name-mobile:{{ section.settings.name_mobile }}px;--mm-ohero-ratio:{{ section.settings.ratio }};--mm-ohero-radius:{{ section.settings.radius }}px;--mm-ohero-frame:{{ section.settings.frame_colour }};--mm-ohero-accent-size:{{ section.settings.accent_size }}px;--mm-ohero-outline:{{ section.settings.outline_opacity | divided_by: 100.0 }}}
{% endstyle %}

{% stylesheet %}
.mm-ohero{position:relative;overflow:hidden;isolation:isolate}
.mm-ohero__inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:clamp(32px,5vw,88px)}
.mm-ohero--media-left .mm-ohero__media{order:-1}
.mm-ohero__copy{display:grid;gap:22px;justify-items:start}
.mm-home .mm-ohero__name{font-size:var(--mm-ohero-name,140px);line-height:.86;letter-spacing:-.03em;text-transform:uppercase;overflow-wrap:anywhere}
.mm-ohero__text{font-size:clamp(16px,1.3vw,19px);line-height:1.55;max-width:46ch}
.mm-ohero__text p{margin:0 0 .6em}
.mm-ohero__meta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px}
.mm-ohero__count{font-size:14px;letter-spacing:.02em}
.mm-ohero__count strong{font-size:20px;color:var(--mm-accent)}
.mm-home .mm-ohero__button{display:inline-flex;align-items:center;gap:14px;border-radius:100px;padding:16px 26px;background:var(--mm-ink);color:var(--mm-paper);font-size:14px;font-weight:700;transition:background .25s,color .25s,translate .3s}
.mm-home .mm-ohero__button:hover{background:var(--mm-accent);color:var(--mm-ink);translate:0 -2px}
.mm-ohero__button .mm-icon{transition:translate .3s}
.mm-ohero__button:hover .mm-icon{translate:0 3px}
.mm-ohero__characters{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 0;padding:0;list-style:none}
.mm-home .mm-ohero__chip{display:inline-flex;align-items:center;gap:8px;padding:8px 14px 8px 10px;border-radius:100px;border:1px solid color-mix(in srgb,var(--mm-ink) 18%,transparent);font-size:13px;transition:background .3s,border-color .3s,color .3s}
.mm-ohero__chip .mm-symbol-mask{width:18px;background-color:var(--mm-ink)!important;transition:background-color .3s,rotate .7s cubic-bezier(.34,1.56,.64,1)}
.mm-home .mm-ohero__chip:hover{border-color:var(--mm-char)}
.mm-ohero__chip:hover .mm-symbol-mask{background-color:var(--mm-char)!important;rotate:120deg}
.mm-ohero__media{position:relative}
.mm-ohero__frame{aspect-ratio:var(--mm-ohero-ratio,4/5);border-radius:var(--mm-ohero-radius,28px);overflow:hidden;background:var(--mm-ohero-frame)}
.mm-ohero__image{width:100%;height:100%;object-fit:cover;display:block;transition:scale 1.4s cubic-bezier(.22,1,.36,1)}
.mm-ohero__media:hover .mm-ohero__image{scale:1.04}
.mm-ohero__accent{position:absolute;left:clamp(-40px,-3vw,-16px);bottom:clamp(24px,6%,56px);width:var(--mm-ohero-accent-size,150px);aspect-ratio:1}
.mm-ohero--media-left .mm-ohero__accent{left:auto;right:clamp(-40px,-3vw,-16px)}
.mm-ohero__clock{display:block;filter:drop-shadow(0 18px 30px rgb(0 0 0 / .18))}
.mm-ohero__clock svg{display:block;width:100%;height:100%;overflow:visible}
.mm-ohero__clock-face{fill:var(--mm-paper);stroke:var(--mm-ink);stroke-width:2}
.mm-ohero__clock-tick{stroke:var(--mm-ink);stroke-width:2;stroke-linecap:round}
.mm-ohero__clock-hour,.mm-ohero__clock-minute{stroke:var(--mm-ink);stroke-linecap:round}
.mm-ohero__clock-hour{stroke-width:5}
.mm-ohero__clock-minute{stroke-width:3.5}
.mm-ohero__clock-second{stroke:var(--mm-accent);stroke-width:1.6;stroke-linecap:round}
.mm-ohero__clock-pin{fill:var(--mm-accent)}
.mm-ohero__symbol .mm-symbol-mask{width:100%;animation:mm-ohero-spin 24s linear infinite}
@keyframes mm-ohero-spin{to{rotate:360deg}}
.mm-ohero__badge{position:absolute;top:clamp(-30px,-2vw,-14px);right:clamp(-30px,-2vw,-14px);display:grid;place-items:center;width:124px;aspect-ratio:1;border-radius:50%;background:var(--mm-accent);color:var(--mm-ink)}
.mm-ohero--media-left .mm-ohero__badge{right:auto;left:clamp(-30px,-2vw,-14px)}
.mm-ohero__badge svg{position:absolute;inset:0;width:100%;height:100%;animation:mm-ohero-spin 18s linear infinite}
.mm-ohero__badge text{font-size:10.5px;font-weight:700;letter-spacing:.12em;fill:currentColor}
.mm-ohero__badge-count{font-family:'MM Cocogoose','MM Proxima Nova',Arial,sans-serif;font-size:30px;line-height:1}
.mm-ohero__outline{position:absolute;left:0;right:0;bottom:-.12em;z-index:-1;overflow:hidden;pointer-events:none;font-family:'MM Cocogoose','MM Proxima Nova',Arial,sans-serif;font-size:clamp(120px,22vw,340px);line-height:1;text-transform:uppercase;white-space:nowrap;color:transparent;-webkit-text-stroke:1.5px var(--mm-ink);opacity:var(--mm-ohero-outline,.12)}
.mm-ohero__outline-track{display:inline-flex;gap:.4em;animation:mm-ohero-slide 60s linear infinite}
@keyframes mm-ohero-slide{to{translate:-50% 0}}
.mm-symbol-mask{display:block;aspect-ratio:1;background-color:var(--mm-symbol-color,currentColor);-webkit-mask:var(--mm-symbol-url) center/contain no-repeat;mask:var(--mm-symbol-url) center/contain no-repeat}
@media(max-width:989px){
  .mm-ohero__inner{grid-template-columns:1fr}
  .mm-ohero--media-left .mm-ohero__media{order:0}
  .mm-ohero__media{margin-inline:12px}
}
@media(max-width:749px){
  .mm-home .mm-ohero__name{font-size:var(--mm-ohero-name-mobile,64px)}
  .mm-ohero__accent{width:calc(var(--mm-ohero-accent-size,150px) * .6);left:-8px}
  .mm-ohero--media-left .mm-ohero__accent{right:-8px}
  .mm-ohero__badge{width:92px;top:-14px;right:-8px}
  .mm-ohero__badge text{font-size:10px}
  .mm-ohero__badge-count{font-size:22px}
}
@media(prefers-reduced-motion:reduce){.mm-ohero__badge svg,.mm-ohero__outline-track,.mm-ohero__symbol .mm-symbol-mask{animation:none}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('mm-live-clock')) {
  customElements.define(
    'mm-live-clock',
    class MMLiveClock extends HTMLElement {
      connectedCallback() {
        this.hands = {};
        for (const hand of this.querySelectorAll('[data-hand]')) this.hands[hand.dataset.hand] = hand;
        this.tick();
        this.timer = setInterval(() => this.tick(), 1000);
      }

      disconnectedCallback() {
        clearInterval(this.timer);
      }

      tick() {
        const now = new Date();
        const seconds = now.getSeconds();
        const minutes = now.getMinutes() + seconds / 60;
        const hours = (now.getHours() % 12) + minutes / 60;
        this.hands.hour?.setAttribute('transform', `rotate(${hours * 30} 50 50)`);
        this.hands.minute?.setAttribute('transform', `rotate(${minutes * 6} 50 50)`);
        this.hands.second?.setAttribute('transform', `rotate(${seconds * 6} 50 50)`);
      }
    }
  );
}
{% endjavascript %}

{% schema %}
{
  "name": "MM · Object hero",
  "tag": "div",
  "class": "mm-ohero-section",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The name, text, image and product count come from the collection automatically. Fill in the fields below only to override them."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "The objects"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Object name",
      "info": "Leave empty to use the collection title, for example Clock."
    },
    {
      "type": "select",
      "id": "text_source",
      "label": "Text",
      "default": "description",
      "options": [
        {
          "value": "description",
          "label": "Collection description"
        },
        {
          "value": "custom",
          "label": "Custom text below"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Custom text",
      "default": "<p>Time flies when you are having fun. Our clocks make sure it looks good doing it.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "text",
