      "label": "Count label",
      "default": "pieces to choose from"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See them all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
