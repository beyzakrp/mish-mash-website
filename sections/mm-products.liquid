      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_swatches",
      "label": "Show colour swatches",
      "info": "For an option named Color, Colour, Renk or Metal.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_tags",
      "label": "Show Sale and Sold out tags",
      "default": true
    },
    {
      "type": "text",
      "id": "card_sale_label",
      "label": "Sale tag text",
      "default": "Sale"
    },
    {
      "type": "range",
      "id": "card_title_size",
