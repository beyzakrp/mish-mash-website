      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile spacing",
      "min": 0,
      "max": 150,
      "step": 5,
