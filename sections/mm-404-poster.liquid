{%- liquid
  assign lost_path = request.path | default: '/somewhere-nice' | escape
  case section.settings.photo_character
    when 'showoff'
      assign photo_colour = '#970C38'
    when 'player'
      assign photo_colour = '#CCDB65'
    when 'trickster'
      assign photo_colour = '#192FDA'
    else
      assign photo_colour = '#FB7FB0'
  endcase
-%}
<section class="mm-home mm-lost" id="mm-{{ section.id }}">
  <div class="mm-pad mm-lost__wrap mm-lost__wrap--{{ section.settings.layout }}">
    <div class="mm-lost__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="mm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="mm-lost__heading mm-display">{{ section.settings.heading | escape | newline_to_br }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="mm-lost__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="mm-lost__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="mm-button mm-lost__button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="mm-lost__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} {% render 'mm-icon', icon: 'arrow-up-right' %}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="mm-lost__board">
      <article class="mm-lost__poster" aria-label="{{ section.settings.poster_title | escape }}">
        <span class="mm-lost__tape mm-lost__tape--left" aria-hidden="true"></span>
        <span class="mm-lost__tape mm-lost__tape--right" aria-hidden="true"></span>

        <p class="mm-lost__title mm-display">{{ section.settings.poster_title | escape }}</p>
        {%- if section.settings.poster_subtitle != blank -%}<p class="mm-lost__subtitle">{{ section.settings.poster_subtitle | escape }}</p>{%- endif -%}

        <div class="mm-lost__photo" style="--mm-lost-photo: {{ photo_colour }};">
          {%- if section.settings.photo_image != blank -%}
            {{ section.settings.photo_image | image_url: width: 900 | image_tag: alt: '', loading: 'eager', class: 'mm-lost__photo-image', widths: '400,600,900', sizes: '(min-width: 990px) 420px, 80vw' }}
          {%- else -%}
            <span class="mm-lost__photo-symbol" style="--mm-symbol-url: url({{ 'mm-symbol-' | append: section.settings.photo_character | append: '.svg' | asset_url }});" aria-hidden="true"></span>
          {%- endif -%}
          {%- if section.settings.stamp != blank -%}<span class="mm-lost__stamp" aria-hidden="true">{{ section.settings.stamp | escape }}</span>{%- endif -%}
        </div>

        {%- assign has_details = false -%}
        {%- for block in section.blocks -%}{%- if block.type == 'detail' -%}{%- assign has_details = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- if has_details -%}
          <dl class="mm-lost__details">
            {%- for block in section.blocks -%}
              {%- if block.type == 'detail' -%}
                <div {{ block.shopify_attributes }}>
                  <dt>{{ block.settings.label | escape }}</dt>
                  <dd>{{ block.settings.value | escape | replace: '[path]', lost_path }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- assign has_tabs = false -%}
        {%- for block in section.blocks -%}{%- if block.type == 'tab' -%}{%- assign has_tabs = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- if has_tabs -%}
          {%- if section.settings.tabs_heading != blank -%}<p class="mm-lost__tabs-heading">{{ section.settings.tabs_heading | escape }}</p>{%- endif -%}
          <ul class="mm-lost__tabs" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' -%}
                <li style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
                  <a class="mm-lost__tab" href="{{ block.settings.link | default: routes.root_url }}"><span>{{ block.settings.label | escape }}</span></a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </article>
    </div>
  </div>
</section>

{%- capture mm_section_css -%}{% render 'mm-section-style', settings: section.settings, id: section.id %}{%- endcapture -%}
{% style %}{{ mm_section_css }}{% endstyle %}

{% style %}
#mm-{{ section.id }}{--mm-lost-paper:{{ section.settings.poster_colour }};--mm-lost-paper-ink:{{ section.settings.poster_text }};--mm-lost-tape-1:{{ section.settings.tape_1 }};--mm-lost-tape-2:{{ section.settings.tape_2 }};--mm-lost-tilt:{{ section.settings.tilt }}deg;--mm-lost-title:{{ section.settings.title_size }}px;--mm-lost-heading:{{ section.settings.heading_size }}px;--mm-lost-heading-mobile:{{ section.settings.heading_mobile }}px;--mm-lost-stamp:{{ section.settings.stamp_colour }}}
{%- capture button_selector -%}#mm-{{ section.id }} .mm-lost__button{%- endcapture -%}{% render 'mm-button-style', settings: section.settings, selector: button_selector %}
{% endstyle %}

{% stylesheet %}
.mm-lost{overflow:hidden}
.mm-lost__wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:clamp(40px,6vw,110px);padding-inline:5%}
.mm-lost__wrap--poster-left .mm-lost__copy{order:2}
.mm-lost__copy{display:grid;justify-items:start;gap:20px;max-width:560px}
.mm-home .mm-lost__heading{margin:0;font-size:var(--mm-lost-heading,54px);line-height:1.02;letter-spacing:-.03em;text-wrap:balance}
.mm-lost__text{font-size:17px;line-height:1.55;opacity:.85;max-width:46ch}
.mm-lost__actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:8px}
.mm-home .mm-lost__link{display:inline-flex;align-items:center;gap:8px;padding-bottom:3px;border-bottom:1px solid;font-size:14px;font-weight:700}
.mm-lost__board{display:grid;place-items:center;padding:24px 0}
.mm-lost__poster{position:relative;width:min(100%,460px);padding:34px 30px 0;background:var(--mm-lost-paper);color:var(--mm-lost-paper-ink);box-shadow:0 1px 0 rgba(0,0,0,.04),0 24px 50px -18px rgba(23,21,20,.35);rotate:var(--mm-lost-tilt,-3deg);transition:rotate .6s var(--mm-ease-spring,cubic-bezier(.34,1.56,.64,1));text-align:center}
.mm-lost__poster:hover{rotate:calc(var(--mm-lost-tilt,-3deg) * -.4)}
.mm-lost__tape{position:absolute;top:-14px;width:110px;height:30px;opacity:.9;mix-blend-mode:multiply}
.mm-lost__tape--left{left:-18px;background:var(--mm-lost-tape-1);rotate:-28deg}
.mm-lost__tape--right{right:-18px;background:var(--mm-lost-tape-2);rotate:24deg}
.mm-home .mm-lost__title{margin:0;font-size:var(--mm-lost-title,76px);line-height:.9;letter-spacing:-.02em;text-transform:uppercase}
.mm-lost__subtitle{margin-top:10px!important;font-size:12px;font-weight:700;letter-spacing:.17em;text-transform:uppercase}
.mm-lost__photo{position:relative;display:grid;place-items:center;aspect-ratio:4/3;margin:22px 0 18px;border:2px solid currentColor;background:color-mix(in srgb,var(--mm-lost-photo) 16%,var(--mm-lost-paper));overflow:hidden}
.mm-lost__photo-symbol{width:52%;aspect-ratio:1;background-color:var(--mm-lost-photo);-webkit-mask:var(--mm-symbol-url) center/contain no-repeat;mask:var(--mm-symbol-url) center/contain no-repeat;animation:mm-lost-peek 5s ease-in-out infinite}
.mm-lost__photo-image{width:100%;height:100%;object-fit:cover;display:block}
@keyframes mm-lost-peek{0%,100%{translate:0 0;rotate:-6deg}40%{translate:-6% 3%;rotate:8deg}70%{translate:5% -2%;rotate:-2deg}}
.mm-lost__stamp{position:absolute;right:12px;bottom:14px;padding:6px 12px;border:3px solid var(--mm-lost-stamp,#970C38);border-radius:6px;color:var(--mm-lost-stamp,#970C38);font-size:15px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;rotate:-12deg;opacity:.85}
.mm-lost__details{display:grid;gap:8px;margin:0 0 22px;text-align:left;font-size:14px;line-height:1.4}
.mm-lost__details div{display:grid;grid-template-columns:minmax(90px,auto) 1fr;gap:12px;padding-bottom:8px;border-bottom:1px dashed color-mix(in srgb,currentColor 35%,transparent)}
.mm-lost__details dt{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding-top:2px}
.mm-lost__details dd{margin:0;overflow-wrap:anywhere}
.mm-lost__tabs-heading{font-size:11px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;margin-bottom:10px!important}
.mm-lost__tabs{display:flex;margin:0 -30px;padding:0;list-style:none;border-top:2px dashed currentColor}
.mm-lost__tabs li{flex:1 1 0;min-width:0;transform-origin:50% 0;transition:rotate .45s var(--mm-ease-spring,cubic-bezier(.34,1.56,.64,1)),translate .45s var(--mm-ease-spring,cubic-bezier(.34,1.56,.64,1))}
.mm-lost__tabs li+li{border-left:2px dashed currentColor}
.mm-lost__tabs li:hover{rotate:calc(-6deg + var(--i) * 3deg);translate:0 6px}
.mm-home .mm-lost__tab{display:grid;place-items:center;width:100%;height:136px;padding:14px 4px;}
.mm-lost__tab span{writing-mode:vertical-rl;rotate:180deg;white-space:nowrap}
.mm-home .mm-lost__tab{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;transition:background .25s,color .25s}
.mm-home .mm-lost__tab:hover,.mm-home .mm-lost__tab:focus-visible{background:var(--mm-lost-paper-ink);color:var(--mm-lost-paper)}
@media(max-width:989px){
  .mm-lost__wrap{grid-template-columns:1fr;justify-items:center;text-align:center}
  .mm-lost__wrap--poster-left .mm-lost__copy{order:0}
  .mm-lost__copy{justify-items:center}
  .mm-lost__actions{justify-content:center}
}
@media(max-width:749px){
  .mm-home .mm-lost__heading{font-size:var(--mm-lost-heading-mobile,36px)}
  .mm-lost__text{font-size:15px}
  .mm-lost__poster{padding:28px 20px 0}
  .mm-home .mm-lost__title{font-size:calc(var(--mm-lost-title,76px) * .72)}
  .mm-lost__tabs{margin-inline:-20px}
  .mm-home .mm-lost__tab{height:124px;font-size:11px}
  .mm-lost__poster{width:calc(100% - 24px)}
  .mm-lost__tape{width:80px;height:24px}
}
@media(prefers-reduced-motion:reduce){.mm-lost__photo-symbol{animation:none}}
{% endstylesheet %}

{% schema %}
