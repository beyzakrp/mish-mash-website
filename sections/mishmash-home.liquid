<section class="mm-home" aria-label="{{ shop.name | escape }}">
  <div class="mm-hero">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'mm-hero-image', widths: '600,900,1200,1800,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {% elsif section.settings.reference_images %}
      <picture><source media="(max-width: 600px)" srcset="{{ 'mm-reference-mobile.webp' | asset_url }}"><img class="mm-hero-image" src="{{ 'mm-reference-hero.webp' | asset_url }}" alt="{{ 'mishmash.hero_alt' | t }}" width="2000" height="1333" fetchpriority="high"></picture>
    {% endif %}
    <div class="mm-hero-content">
      <p class="mm-eyebrow">{{ 'mishmash.eyebrow' | t }}</p>
      <h1>{{ section.settings.heading | default: '' | escape }}{% if section.settings.heading == blank %}{{ 'mishmash.heading' | t | newline_to_br }}{% endif %}</h1>
      <p class="mm-intro">{{ 'mishmash.intro' | t }}</p>
      <a class="mm-button" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'mishmash.shop' | t }} <span aria-hidden="true">↗</span></a>
    </div>
    <a class="mm-hero-bottom" href="#mm-personalities-{{ section.id }}">{{ 'mishmash.meet' | t }} <span aria-hidden="true">↓</span></a>
  </div>
  <div class="mm-ticker" aria-hidden="true"><span>mish.</span><span>✳</span><span>mash.</span><span>✿</span><span>mish.</span><span>✳</span><span>mash.</span><span>✿</span><span>mish.</span><span>✳</span><span>mash.</span></div>
  <div class="mm-products mm-pad">
    <div class="mm-section-head"><div><p class="mm-eyebrow">{{ 'mishmash.selection_note' | t }}</p><h2>{{ 'mishmash.selection' | t }}</h2></div><a class="mm-text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'mishmash.all' | t }} <span aria-hidden="true">↗</span></a></div>
    {% assign selected_collection = section.settings.collection | default: collections.all %}
    {% if selected_collection.products.size > 0 %}
      <div class="mm-product-grid">
        {% for product in selected_collection.products limit: 4 %}
          <a class="mm-product" href="{{ product.url }}"><div class="mm-product-media">
            {% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '300,500,750,1000', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
            <span class="mm-product-arrow" aria-hidden="true">↗</span>
          </div><div class="mm-product-meta"><h3>{{ product.title | escape }}</h3><span>{{ product.price | money }}</span></div>{% unless product.available %}<small>{{ 'mishmash.sold_out' | t }}</small>{% endunless %}</a>
        {% endfor %}
      </div>
    {% else %}
      <div class="mm-empty"><span aria-hidden="true">✳</span><h3>{{ 'mishmash.empty' | t }}</h3><p>{{ 'mishmash.empty_note' | t }}</p></div>
    {% endif %}
  </div>
  <div class="mm-personalities mm-pad" id="mm-personalities-{{ section.id }}">
    <div class="mm-section-head"><h2>{{ 'mishmash.characters' | t | newline_to_br }}</h2><p>{{ 'mishmash.characters_note' | t }}</p></div>
    <div class="mm-character-grid">
      {% for block in section.blocks %}
        {% assign character = block.settings.character %}
        {% assign title_key = 'mishmash.' | append: character %}
        {% assign text_key = title_key | append: '_text' %}
        <a class="mm-character mm-character--{{ character }}" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="mm-character-top"><span class="mm-eyebrow">0{{ forloop.index }}</span><span aria-hidden="true">↗</span></div>
          <div class="mm-symbol" aria-hidden="true">
            {% case character %}
              {% when 'showoff' %}<svg viewBox="0 0 100 100"><path d="M50 0 59 20 75 7 76 30 97 25 85 45 100 55 78 63 83 85 62 78 50 100 40 80 20 93 23 70 2 72 15 52 0 40 23 34 17 12 39 21Z"/></svg>
              {% when 'player' %}<svg viewBox="0 0 100 100"><ellipse cx="50" cy="26" rx="14" ry="26"/><ellipse cx="50" cy="26" rx="14" ry="26" transform="rotate(60 50 50)"/><ellipse cx="50" cy="26" rx="14" ry="26" transform="rotate(120 50 50)"/><ellipse cx="50" cy="26" rx="14" ry="26" transform="rotate(180 50 50)"/><ellipse cx="50" cy="26" rx="14" ry="26" transform="rotate(240 50 50)"/><ellipse cx="50" cy="26" rx="14" ry="26" transform="rotate(300 50 50)"/></svg>
              {% when 'trickster' %}<svg viewBox="0 0 100 100"><ellipse cx="50" cy="50" rx="14" ry="64" transform="rotate(45 50 50)"/><ellipse cx="50" cy="50" rx="14" ry="64" transform="rotate(-45 50 50)"/></svg>
              {% when 'helper' %}<svg viewBox="0 0 100 100"><circle cx="50" cy="28" r="26"/><circle cx="27" cy="70" r="26"/><circle cx="73" cy="70" r="26"/></svg>
            {% endcase %}
          </div>
          <h3>{{ title_key | t }}</h3><p>{{ text_key | t }}</p>
        </a>
      {% endfor %}
    </div>
  </div>
  <div class="mm-story">
    <div class="mm-story-media">
      {% if section.settings.story_image != blank %}{{ section.settings.story_image | image_url: width: 1400 | image_tag: widths: '500,900,1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}{% elsif section.settings.reference_images %}<img src="{{ 'mm-reference-story.webp' | asset_url }}" alt="{{ 'mishmash.story_alt' | t }}" width="1000" height="1250" loading="lazy">{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}
    </div>
    <div class="mm-story-copy"><p class="mm-eyebrow">{{ 'mishmash.story_label' | t }}</p><h2>{{ 'mishmash.story_heading' | t | newline_to_br }}</h2><p>{{ 'mishmash.story_text' | t }}</p><a class="mm-button mm-button--light" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'mishmash.story_link' | t }} <span aria-hidden="true">↗</span></a><span class="mm-story-flower" aria-hidden="true">✳</span></div>
  </div>
</section>
{% stylesheet %}
.mm-home{--mm-ink:#171514;--mm-paper:#faf9f5;color:var(--mm-ink);background:var(--mm-paper);font-family:Arial,Helvetica,sans-serif}.mm-home *{box-sizing:border-box}.mm-home h1,.mm-home h2,.mm-home h3,.mm-home p{margin:0;color:inherit;font-family:inherit}.mm-home a{color:inherit;text-decoration:none}.mm-home a:focus-visible{outline:3px solid #171514;outline-offset:5px}.mm-hero{position:relative;min-height:680px;height:calc(100svh - 138px);max-height:960px;background:#ddd9cd;isolation:isolate;overflow:hidden}.mm-hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(0,0,0,.45),transparent 85%)}.mm-hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.mm-hero-content{padding:clamp(28px,5vw,80px);padding-top:clamp(90px,14vh,180px);max-width:1000px;color:white}.mm-eyebrow{font-size:11px!important;text-transform:uppercase;letter-spacing:.17em;font-weight:700;line-height:1.5}.mm-hero h1{font-size:clamp(48px,6.4vw,100px);font-weight:700;line-height:.99;letter-spacing:-.065em;margin:22px 0;max-width:850px;text-wrap:balance}.mm-intro{font-size:17px;line-height:1.5;margin-bottom:28px!important}.mm-button{display:inline-flex;align-items:center;justify-content:space-between;gap:30px;border-radius:100px;padding:19px 25px;background:#faf9f5;color:#171514!important;font-size:13px;font-weight:700;min-height:52px;transition:background .2s,transform .2s}.mm-button:hover{background:#ff6ea7;transform:translateY(-2px)}.mm-button span{font-size:22px;line-height:1}.mm-hero-bottom{position:absolute;bottom:28px;left:5%;right:5%;display:flex;justify-content:space-between;color:white!important;text-transform:uppercase;font-size:10px;letter-spacing:.16em;font-weight:700}.mm-ticker{height:78px;display:flex;justify-content:space-around;gap:30px;align-items:center;overflow:hidden;white-space:nowrap;background:#ff6ea7;font-size:36px;font-weight:800;letter-spacing:-.05em}.mm-ticker span:nth-child(even){font-size:40px}.mm-pad{padding:90px 5%}.mm-section-head{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:36px}.mm-home h2{font-size:clamp(36px,4.3vw,64px);font-weight:700;line-height:1.04;letter-spacing:-.055em}.mm-section-head .mm-eyebrow{margin-bottom:12px}.mm-text-link{font-size:13px;border-bottom:1px solid;padding-bottom:7px;white-space:nowrap}.mm-text-link span{margin-left:24px}.mm-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.mm-product-media{position:relative;aspect-ratio:4/5;background:#eeece6;overflow:hidden}.mm-product-media img,.mm-product-media svg{height:100%;width:100%;object-fit:cover;transition:transform .4s}.mm-product:hover img{transform:scale(1.035)}.mm-product-arrow{position:absolute;bottom:14px;right:14px;display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--mm-paper);font-size:23px}.mm-product-meta{display:flex;justify-content:space-between;gap:12px;padding-top:15px;font-size:13px;line-height:1.5}.mm-product-meta h3{font-size:14px;font-weight:700;letter-spacing:-.02em}.mm-product-meta>span{white-space:nowrap}.mm-empty{text-align:center;padding:48px 20px;border-top:1px solid #d9d6d0;border-bottom:1px solid #d9d6d0}.mm-empty>span{font-size:65px;color:#1e6448}.mm-empty h3{font-size:24px;margin:12px}.mm-empty p{font-size:14px}.mm-personalities{padding-top:20px}.mm-section-head>p{font-size:14px}.mm-character-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.mm-character{padding:25px 22px 32px;min-height:350px;transition:transform .25s;border-radius:3px}.mm-character:hover{transform:translateY(-6px)}.mm-character--showoff{background:#1e6448;color:white!important}.mm-character--player{background:#f37400}.mm-character--trickster{background:#4ca7ff}.mm-character--helper{background:#ff6ea7}.mm-character-top{display:flex;justify-content:space-between;align-items:center}.mm-character-top>span:last-child{font-size:24px}.mm-symbol{width:120px;height:120px;margin:32px auto;transition:transform .4s}.mm-symbol svg{width:100%;height:100%;fill:currentColor}.mm-character:hover .mm-symbol{transform:rotate(12deg)}.mm-character h3{font-size:clamp(20px,2vw,30px);font-weight:800;letter-spacing:-.055em}.mm-character p{margin-top:8px;font-size:13px}.mm-story{display:grid;grid-template-columns:1fr 1fr;background:#e9eddf}.mm-story-media{min-height:600px}.mm-story-media img,.mm-story-media svg{width:100%;height:100%;max-height:760px;object-fit:cover;display:block}.mm-story-copy{position:relative;padding:70px 12%;display:flex;flex-direction:column;align-items:start;justify-content:center;overflow:hidden}.mm-story-copy h2{margin:25px 0}.mm-story-copy>p:not(.mm-eyebrow){font-size:16px;line-height:1.75;max-width:360px}.mm-story-copy .mm-button{margin-top:32px;background:#171514;color:white!important}.mm-story-copy .mm-button:hover{background:#1e6448}.mm-story-flower{font-size:130px;line-height:1;color:#1e6448;margin-top:40px;align-self:end}.mm-home a:focus-visible.mm-hero-bottom{outline-color:white}@media(max-width:749px){.mm-hero{height:80svh;min-height:580px;max-height:800px}.mm-hero-content{padding:34px 24px;padding-top:105px}.mm-hero h1{font-size:54px;max-width:540px}.mm-intro{font-size:15px;max-width:260px}.mm-hero:after{background:linear-gradient(90deg,rgba(0,0,0,.53),rgba(0,0,0,.08))}.mm-ticker{height:58px;font-size:28px;gap:25px}.mm-pad{padding:55px 20px}.mm-personalities{padding-top:0}.mm-section-head{align-items:start;flex-direction:column;gap:18px}.mm-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px}.mm-product-meta{flex-direction:column;gap:3px}.mm-character-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.mm-character{min-height:275px;padding:18px 15px 25px}.mm-symbol{width:90px;height:90px;margin:25px auto}.mm-character h3{font-size:21px}.mm-character p{font-size:11px}.mm-story{grid-template-columns:1fr}.mm-story-media{min-height:0;aspect-ratio:1/1}.mm-story-copy{padding:45px 25px}.mm-story-flower{font-size:90px;margin-top:20px}.mm-story-copy h2{font-size:43px}}@media(prefers-reduced-motion:reduce){.mm-home *{transition:none!important;scroll-behavior:auto!important}}
{% endstylesheet %}
{% schema %}
{
 "name":"Mish-mash home",
 "settings":[
  {"type":"text","id":"heading","label":"Opening heading"},
  {"type":"image_picker","id":"hero_image","label":"Opening image"},
  {"type":"image_picker","id":"story_image","label":"Story image"},
  {"type":"collection","id":"collection","label":"Featured collection"},
  {"type":"checkbox","id":"reference_images","label":"Use temporary reference photos","default":false,"info":"Replace these Roki reference photos with your own images before publishing."}
 ],
 "max_blocks":4,
 "blocks":[{"type":"personality","name":"Personality","settings":[{"type":"select","id":"character","label":"Character","options":[{"value":"showoff","label":"The Show-off"},{"value":"player","label":"The Player"},{"value":"trickster","label":"The Trickster"},{"value":"helper","label":"The Helper"}],"default":"showoff"},{"type":"collection","id":"collection","label":"Linked collection"}]}],
 "presets":[{"name":"Mish-mash home","blocks":[{"type":"personality","settings":{"character":"showoff"}},{"type":"personality","settings":{"character":"player"}},{"type":"personality","settings":{"character":"trickster"}},{"type":"personality","settings":{"character":"helper"}}]}]
}
{% endschema %}
