

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% if section.settings.card_style == 'mishmash' %}
  {% style %}
    #shopify-section-{{ section.id }} .product-grid.product-grid--{{ section.id }}[product-grid-view='default']{gap:0;grid-template-columns:repeat({{ section.settings.card_columns_mobile }},minmax(0,1fr))}
    @media screen and (min-width: 750px){#shopify-section-{{ section.id }} .product-grid.product-grid--{{ section.id }}[product-grid-view='default']{grid-template-columns:repeat({{ section.settings.card_columns | at_most: 3 }},minmax(0,1fr))}}
    @media screen and (min-width: 990px){#shopify-section-{{ section.id }} .product-grid.product-grid--{{ section.id }}[product-grid-view='default']{grid-template-columns:repeat({{ section.settings.card_columns }},minmax(0,1fr))}}
    #shopify-section-{{ section.id }} .product-grid--{{ section.id }} .mm-card{--mm-card-bg:{{ section.settings.card_image_bg }};--mm-card-pad:{{ section.settings.card_image_padding }}%;--mm-card-title-size:{{ section.settings.card_title_size }}px}
    #shopify-section-{{ section.id }} .product-grid--{{ section.id }}[product-grid-view='zoom-out'] .mm-card__info{display:none}
    {% if section.settings.card_edge_to_edge %}
      #shopify-section-{{ section.id }} .product-grid-container{padding-inline:0}
      #shopify-section-{{ section.id }} .product-grid-container > .collection-wrapper{grid-column:1 / -1;width:100%;max-width:none}
      #shopify-section-{{ section.id }} .main-collection-grid{padding-inline:0 !important;margin-inline:0 !important}
      #shopify-section-{{ section.id }} .collection-wrapper:not(:has(.facets-block-wrapper--vertical:not(.hidden):not(#filters-drawer))) > .main-collection-grid{grid-column:1 / -1 !important}
      #shopify-section-{{ section.id }} .main-collection-grid > div{padding-inline:0}
      #shopify-section-{{ section.id }} .product-grid.product-grid--{{ section.id }}{width:100%;max-width:none;margin-inline:0}
    {% endif %}
    {% if section.settings.card_lines %}
      #shopify-section-{{ section.id }} .product-grid--{{ section.id }}[product-grid-view='default']{border-top:1px solid {{ section.settings.card_line_colour }}}
      #shopify-section-{{ section.id }} .product-grid--{{ section.id }}[product-grid-view='default'] .product-grid__item{position:relative;box-shadow:inset -1px 0 0 {{ section.settings.card_line_colour }},inset 0 -1px 0 {{ section.settings.card_line_colour }}}
      #shopify-section-{{ section.id }} .product-grid--{{ section.id }}[product-grid-view='default'] .mm-card__media{margin:0 1px 0 0}
      #shopify-section-{{ section.id }} .product-grid--{{ section.id }}[product-grid-view='default'] .mm-card{padding-bottom:1px}
    {% else %}
      #shopify-section-{{ section.id }} .product-grid.product-grid--{{ section.id }}[product-grid-view='default']{gap:28px 12px}
    {% endif %}
  {% endstyle %}
{% endif %}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 24 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% if section.settings.card_style == 'mishmash' %}
                {% liquid
                  assign card_eager = false
                  if forloop.index <= section.settings.card_columns and paginate.current_page == 1
                    assign card_eager = true
                  endif
                %}
                {% render 'mm-product-card', product: product, settings: section.settings, eager: card_eager %}
              {% else %}
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  closest.product: product,
                  product_view_context: 'collection'
                %}
              {% endif %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Mish Mash product cards"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "mishmash",
      "options": [
        {
          "value": "mishmash",
          "label": "Mish Mash"
        },
        {
          "value": "theme",
          "label": "Theme default"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "card_columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "card_edge_to_edge",
      "label": "Products edge to edge",
      "info": "Removes the side spacing around the products. Filters and headings keep theirs.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_lines",
      "label": "Thin lines between cards",
      "default": true
    },
    {
      "type": "color",
      "id": "card_line_colour",
      "label": "Line colour",
      "default": "#E6E3DC"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Image shape",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "tall",
          "label": "Tall 3:4"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape 5:4"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_fit",
      "label": "Image fit",
      "default": "contain",
      "info": "Contain suits cut-out product shots, cover suits lifestyle photos.",
      "options": [
        {
          "value": "contain",
          "label": "Show the whole product"
        },
        {
          "value": "cover",
          "label": "Fill the tile"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_image_padding",
      "label": "Space around the product",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "color",
      "id": "card_image_bg",
      "label": "Image background",
      "default": "#F4F3EF"
    },
    {
      "type": "checkbox",
      "id": "card_hover_image",
      "label": "Show second photo on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_character",
      "label": "Show character symbol",
      "info": "Uses the Character product field.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_swatches",
      "label": "Show colour swatches",
      "info": "For an option named Color, Colour, Renk or Metal.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_tags",
      "label": "Show Sale and Sold out tags",
      "default": true
    },
    {
      "type": "text",
      "id": "card_sale_label",
      "label": "Sale tag text",
      "default": "Sale"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Product name size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    }
  ],
  "presets": []
}
{% endschema %}
