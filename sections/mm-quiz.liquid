{%- liquid
  assign question_count = 0
  for block in section.blocks
    if block.type == 'question'
      assign question_count = question_count | plus: 1
    endif
  endfor
-%}
<section class="mm-home mm-quiz" id="mm-{{ section.id }}">
  <div class="mm-pad">
    <mm-quiz class="mm-quiz__box" data-total="{{ question_count }}">
      <div class="mm-quiz__progress" aria-hidden="true"><span></span></div>

      <div class="mm-quiz__step mm-quiz__intro is-in" data-quiz-intro>
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
          <div class="mm-section-head">
            <div>
              {%- if section.settings.eyebrow != blank -%}<p class="mm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
              {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
            </div>
            {%- if section.settings.text != blank -%}<p class="mm-section-text">{{ section.settings.text | escape | newline_to_br }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_symbols -%}
          <div class="mm-quiz__symbols" aria-hidden="true">
            {%- assign quiz_symbols = 'showoff,player,trickster,helper' | split: ',' -%}
            {%- for symbol in quiz_symbols -%}
              {%- liquid
  case symbol
    when 'showoff'
      assign symbol_colour = '#1E6448'
    when 'player'
      assign symbol_colour = '#F37400'
    when 'trickster'
      assign symbol_colour = '#4CA7FF'
    when 'helper'
      assign symbol_colour = '#FF6EA7'
    else
      assign symbol_colour = 'currentColor'
  endcase
-%}
              <span class="mm-symbol-mask" style="--mm-symbol-url: url({{ 'mm-symbol-' | append: symbol | append: '.svg' | asset_url }}); --mm-symbol-color: {{ symbol_colour }}; --i: {{ forloop.index0 }};"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if question_count > 0 -%}
          <button type="button" class="mm-quiz__button" data-quiz-start>{{ section.settings.start_label | escape }} <span aria-hidden="true">→</span></button>
        {%- endif -%}
      </div>

      {%- assign question_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          {%- assign question_index = question_index | plus: 1 -%}
          <div class="mm-quiz__step mm-quiz__question" data-quiz-question hidden {{ block.shopify_attributes }}>
            <p class="mm-quiz__count">{{ question_index }} / {{ question_count }}</p>
            <h3 class="mm-display">{{ block.settings.question | escape }}</h3>
            <div class="mm-quiz__answers">
              {%- for i in (1..4) -%}
                {%- liquid
                  assign answer_key = 'answer_' | append: i
                  assign answer_char_key = 'answer_' | append: i | append: '_character'
                  assign answer = block.settings[answer_key]
                  assign answer_character = block.settings[answer_char_key]
                -%}
                {%- if answer != blank -%}
                  {%- liquid
  case answer_character
    when 'showoff'
      assign answer_colour = '#1E6448'
    when 'player'
      assign answer_colour = '#F37400'
    when 'trickster'
      assign answer_colour = '#4CA7FF'
    when 'helper'
      assign answer_colour = '#FF6EA7'
    else
      assign answer_colour = 'currentColor'
  endcase
-%}
                  <button type="button" class="mm-quiz__answer" data-character="{{ answer_character }}" style="--mm-char: {{ answer_colour }};">
                    {%- if section.settings.answer_symbols -%}
                      <span class="mm-symbol-mask" style="--mm-symbol-url: url({{ 'mm-symbol-' | append: answer_character | append: '.svg' | asset_url }}); --mm-symbol-color: var(--mm-char);" aria-hidden="true"></span>
                    {%- endif -%}
                    <span>{{ answer | escape }}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'result' -%}
          {%- liquid
            assign result_character = block.settings.character
            assign result_name_key = 'mishmash.' | append: result_character
            assign result_collection = block.settings.collection
            assign result_title = block.settings.title
            if result_title == blank
              assign result_title = result_name_key | t
            endif
          -%}
          {%- liquid
  case result_character
    when 'showoff'
      assign result_colour = '#1E6448'
    when 'player'
      assign result_colour = '#F37400'
    when 'trickster'
      assign result_colour = '#4CA7FF'
    when 'helper'
      assign result_colour = '#FF6EA7'
    else
      assign result_colour = 'currentColor'
  endcase
-%}
          <div class="mm-quiz__step mm-quiz__result" data-quiz-result="{{ result_character }}" hidden style="--mm-char: {{ result_colour }};" {{ block.shopify_attributes }}>
            <div class="mm-quiz__result-symbol" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy' }}
              {%- else -%}
                <span class="mm-symbol-mask" style="--mm-symbol-url: url({{ 'mm-symbol-' | append: result_character | append: '.svg' | asset_url }}); --mm-symbol-color: var(--mm-char);"></span>
              {%- endif -%}
            </div>
            <div class="mm-quiz__result-copy">
              {%- if section.settings.result_label != blank -%}<p class="mm-eyebrow">{{ section.settings.result_label | escape }}</p>{%- endif -%}
              <h3 class="mm-display">{{ result_title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="mm-quiz__result-text">{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
              {%- if result_collection != blank and block.settings.product_count > 0 -%}
                <ul class="mm-quiz__products" role="list">
                  {%- for product in result_collection.products limit: block.settings.product_count -%}
                    <li>
                      <a href="{{ product.url }}">
                        <span class="mm-quiz__product-media">
                          {%- if product.featured_image -%}
                            {{ product.featured_image | image_url: width: 500 | image_tag: alt: product.featured_image.alt, loading: 'lazy', widths: '200,350,500', sizes: '160px' }}
                          {%- endif -%}
                        </span>
                        <span class="mm-quiz__product-title">{{ product.title | escape }}</span>
                        {%- if section.settings.show_price -%}<span class="mm-quiz__product-price">{{ product.price | money }}</span>{%- endif -%}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="mm-quiz__actions">
                {%- if block.settings.button_label != blank -%}
                  <a class="mm-quiz__button" href="{{ block.settings.button_link | default: result_collection.url | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
                {%- endif -%}
                <button type="button" class="mm-quiz__restart" data-quiz-restart>{{ section.settings.restart_label | escape }}</button>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </mm-quiz>
  </div>
</section>

{%- capture mm_section_css -%}{% render 'mm-section-style', settings: section.settings, id: section.id %}{%- endcapture -%}
{% style %}{{ mm_section_css }}{% endstyle %}

{% style %}
#mm-{{ section.id }} .mm-quiz__box{--mm-quiz-card:{{ section.settings.card_background }};--mm-quiz-radius:{{ section.settings.card_radius }}px;min-height:{{ section.settings.min_height }}px}
{% endstyle %}

{% stylesheet %}
.mm-quiz__box{position:relative;display:grid;background:var(--mm-quiz-card);border-radius:var(--mm-quiz-radius);padding:clamp(28px,5vw,72px);overflow:hidden}
.mm-quiz__box>.mm-quiz__step{grid-area:1/1}
.mm-quiz__progress{position:absolute;left:0;right:0;top:0;height:4px;background:color-mix(in srgb,var(--mm-ink) 8%,transparent)}
.mm-quiz__progress span{display:block;height:100%;width:var(--mm-quiz-progress,0%);background:var(--mm-accent);transition:width .6s cubic-bezier(.22,1,.36,1)}
.mm-quiz__step{display:flex;flex-direction:column;justify-content:center;gap:24px;opacity:0;translate:0 14px;transition:opacity .45s ease,translate .7s cubic-bezier(.22,1,.36,1)}
.mm-quiz__step.is-in{opacity:1;translate:0 0}
.mm-quiz__step[hidden]{display:none!important}
.mm-quiz__intro{display:grid!important;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);align-content:center;column-gap:clamp(24px,5vw,80px);row-gap:28px}
.mm-quiz__intro>:not(.mm-quiz__symbols){grid-column:1}
.mm-quiz__intro .mm-section-head{display:block;margin-bottom:0}
.mm-quiz__intro .mm-section-text{margin-top:16px!important;font-size:17px;line-height:1.5;max-width:40ch}
.mm-quiz__symbols{grid-column:2;grid-row:1/span 2;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,3vw,40px);justify-items:center;align-self:center}
.mm-quiz__symbols .mm-symbol-mask{width:clamp(56px,9vw,140px);animation:mm-quiz-float 3s ease-in-out infinite;animation-delay:calc(var(--i) * .2s)}
@keyframes mm-quiz-float{0%,100%{translate:0 0}50%{translate:0 -10px}}
.mm-symbol-mask{display:block;aspect-ratio:1;background-color:var(--mm-symbol-color,currentColor);-webkit-mask:var(--mm-symbol-url) center/contain no-repeat;mask:var(--mm-symbol-url) center/contain no-repeat}
.mm-quiz .mm-quiz__button{align-self:flex-start;justify-self:start;display:inline-flex;align-items:center;gap:18px;border:0;border-radius:100px;padding:17px 28px;background:var(--mm-ink);color:var(--mm-paper);font:inherit;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;transition:background .25s,color .25s,translate .3s}
.mm-quiz .mm-quiz__button:hover{background:var(--mm-accent);color:var(--mm-ink);translate:0 -2px}
.mm-quiz__count{font-size:12px;font-weight:700;letter-spacing:.16em;opacity:.55}
.mm-quiz__question h3{font-size:clamp(26px,3.2vw,46px);line-height:1.05;max-width:22ch}
.mm-quiz__answers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:820px}
.mm-quiz__answer{display:flex;align-items:center;gap:14px;text-align:left;padding:20px 22px;border:1px solid color-mix(in srgb,var(--mm-ink) 18%,transparent);border-radius:14px;background:transparent;color:inherit;font:inherit;font-size:16px;cursor:pointer;transition:border-color .25s,background .25s,translate .3s}
.mm-quiz__answer .mm-symbol-mask{width:26px;flex:none;background-color:var(--mm-ink);transition:background-color .3s,rotate .6s cubic-bezier(.34,1.56,.64,1)}
.mm-quiz__answer:hover,.mm-quiz__answer:focus-visible{border-color:var(--mm-char);background:color-mix(in srgb,var(--mm-char) 10%,transparent);translate:0 -2px}
.mm-quiz__answer:hover .mm-symbol-mask,.mm-quiz__answer:focus-visible .mm-symbol-mask{background-color:var(--mm-char);rotate:90deg}
.mm-quiz__result{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:center;gap:clamp(24px,5vw,72px)}
.mm-quiz__result-symbol{aspect-ratio:1;max-width:360px;width:100%;justify-self:center}
.mm-quiz__result-symbol>*{width:100%;height:100%;object-fit:contain;rotate:-90deg;scale:.4;transition:rotate 1.1s cubic-bezier(.34,1.56,.64,1),scale .9s cubic-bezier(.34,1.56,.64,1)}
.mm-quiz__result.is-in .mm-quiz__result-symbol>*{rotate:0deg;scale:1}
.mm-quiz__result-copy{display:grid;gap:16px}
.mm-quiz__result h3{font-size:clamp(34px,4.6vw,72px);line-height:1;color:var(--mm-char)}
.mm-quiz__result-text{font-size:17px;line-height:1.5;max-width:46ch}
.mm-quiz__products{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px;margin:8px 0 0;padding:0;list-style:none}
.mm-quiz__products a{display:grid;gap:6px;font-size:13px}
.mm-quiz__product-media{display:block;aspect-ratio:4/5;border-radius:10px;overflow:hidden;background:color-mix(in srgb,var(--mm-ink) 6%,transparent)}
.mm-quiz__product-media img{width:100%;height:100%;object-fit:cover;transition:scale 1s cubic-bezier(.22,1,.36,1)}
.mm-quiz__products a:hover img{scale:1.05}
.mm-quiz__product-price{opacity:.6}
.mm-quiz__actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:8px}
.mm-quiz__restart{border:0;background:none;padding:0;color:inherit;font:inherit;font-size:13px;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
@media(max-width:749px){.mm-quiz__answers,.mm-quiz__result,.mm-quiz__intro{grid-template-columns:1fr!important}.mm-quiz__symbols{grid-column:1;grid-row:auto;grid-template-columns:repeat(4,minmax(0,1fr))}.mm-quiz__result-symbol{max-width:180px}}
@media(prefers-reduced-motion:reduce){.mm-quiz__step,.mm-quiz__result-symbol>*,.mm-quiz__symbols .mm-symbol-mask{transition:none;animation:none;rotate:none;scale:none;translate:none}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('mm-quiz')) {
  customElements.define(
    'mm-quiz',
    class MMQuiz extends HTMLElement {
      connectedCallback() {
        this.scores = {};
        this.index = 0;
        this.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target) return;
          if (target.closest('[data-quiz-start]')) this.start();
          else if (target.closest('[data-quiz-restart]')) this.restart();
          else {
            const answer = target.closest('[data-character]');
            if (answer instanceof HTMLElement) this.answer(answer.dataset.character);
          }
        });
        document.addEventListener('shopify:block:select', (event) => {
          if (event.target instanceof HTMLElement && this.contains(event.target)) this.show(event.target);
        });
      }

      get questions() {
        return [...this.querySelectorAll('[data-quiz-question]')];
      }

      show(step, progress = 0) {
        for (const element of this.querySelectorAll('.mm-quiz__step')) {
          element.hidden = element !== step;
          element.classList.remove('is-in');
        }
        requestAnimationFrame(() => requestAnimationFrame(() => step.classList.add('is-in')));
        this.style.setProperty('--mm-quiz-progress', `${progress}%`);
        const focusTarget = step.querySelector('button, a');
        if (this.started && focusTarget instanceof HTMLElement) focusTarget.focus({ preventScroll: true });
      }

      start() {
        this.started = true;
        this.scores = {};
        this.index = 0;
        this.last = null;
        const first = this.questions[0];
        if (first) this.show(first, 0);
      }

      answer(character) {
        if (!character) return;
        this.scores[character] = (this.scores[character] || 0) + 1;
        this.last = character;
        this.index += 1;
        const total = this.questions.length;
        const next = this.questions[this.index];
        if (next) {
          this.show(next, (this.index / total) * 100);
          return;
        }
        let winner = this.last;
        for (const [name, score] of Object.entries(this.scores)) {
          if (score > (this.scores[winner] || 0)) winner = name;
        }
        const result =
          this.querySelector(`[data-quiz-result="${winner}"]`) || this.querySelector('[data-quiz-result]');
        if (result instanceof HTMLElement) this.show(result, 100);
      }

      restart() {
        const intro = this.querySelector('[data-quiz-intro]');
        if (intro instanceof HTMLElement) this.show(intro, 0);
      }
    }
  );
}
{% endjavascript %}

