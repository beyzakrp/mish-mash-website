{% liquid
 assign image_loading = 'eager'
 assign image_priority = 'high'
 if section.index > 1
 assign image_loading = 'lazy'
 assign image_priority = 'auto'
 endif
%}
<section class="mm-home" id="mm-{{ section.id }}">
  <div class="mm-hero">
    {% if section.settings.mobile_image != blank %}<style>@media(max-width:600px){#mm-{{ section.id }} .mm-desktop-image{display:none}#mm-{{ section.id }} .mm-mobile-image{display:block}}@media(min-width:601px){#mm-{{ section.id }} .mm-mobile-image{display:none}}</style>{{ section.settings.mobile_image | image_url: width: 1000 | image_tag: class: 'mm-hero-image mm-mobile-image', loading: image_loading, fetchpriority: image_priority }}{% endif %}
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'mm-hero-image mm-desktop-image', widths: '600,900,1200,1800,2400', sizes: '100vw', loading: image_loading, fetchpriority: image_priority }}
    {% elsif section.settings.reference_images %}
      <picture class="mm-desktop-image"><source media="(max-width: 600px)" srcset="{{ 'mm-reference-mobile.webp' | asset_url }}"><img class="mm-hero-image" src="{{ 'mm-reference-hero.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="2000" height="1333" loading="{{ image_loading }}" fetchpriority="{{ image_priority }}"></picture>
    {% endif %}
    <div class="mm-hero-content">
      <p class="mm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
      <p class="mm-intro">{{ section.settings.intro | escape }}</p>
      {% if section.settings.button_label != blank %}<a class="mm-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    {% if section.settings.secondary_label != blank %}<a class="mm-hero-bottom" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">↓</span></a>{% endif %}
  </div>

</section>

{% style %}
#mm-{{ section.id }}{--mm-paper:{{ section.settings.background }};--mm-ink:{{ section.settings.text_color }};background:var(--mm-paper);color:var(--mm-ink)}
#mm-{{ section.id }} .mm-button{background:{{ section.settings.button_background }};color:{{ section.settings.button_text }}!important}
{% endstyle %}
{% style %}
#mm-{{ section.id }} .mm-hero{height:{{ section.settings.height }}px;min-height:0;background:{{ section.settings.background }}}
#mm-{{ section.id }} .mm-hero-content,#mm-{{ section.id }} .mm-hero-bottom{color:{{ section.settings.text_color }}!important}
#mm-{{ section.id }} .mm-hero:after{background:linear-gradient(90deg,rgba(0,0,0,{{ section.settings.overlay | divided_by: 100.0 }}),transparent 85%)}
#mm-{{ section.id }} h1{font-size:{{ section.settings.heading_size }}px}
@media(max-width:749px){#mm-{{ section.id }} .mm-hero{height:{{ section.settings.mobile_height }}px}#mm-{{ section.id }} h1{font-size:{{ section.settings.heading_mobile }}px}}
{% endstyle %}
{% style %}{% if section.settings.heading_font == 'cocogoose' %}#mm-{{ section.id }} h1,#mm-{{ section.id }} h2,#mm-{{ section.id }} h3{font-family:'MM Cocogoose','MM Proxima Nova',Arial,sans-serif;font-weight:400;font-synthesis:none}{% elsif section.settings.heading_font == 'proxima' %}#mm-{{ section.id }} h1,#mm-{{ section.id }} h2,#mm-{{ section.id }} h3{font-family:'MM Proxima Nova',Arial,sans-serif}{% endif %}{% endstyle %}{% style %}#mm-{{ section.id }} .mm-hero{max-height:none}{% endstyle %}
{% style %}{% if section.settings.height_mode == 'responsive' %}#mm-{{ section.id }} .mm-hero{height:calc(100svh - 138px);min-height:680px;max-height:960px}@media(max-width:749px){#mm-{{ section.id }} .mm-hero{height:80svh;min-height:580px;max-height:800px}}{% endif %}{% endstyle %}
{% schema %}
{
  "name": "MM \u00b7 Opening image",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Objects with a playful side"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A little unexpected.\nA lot of personality."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Description",
      "default": "Good company for your everyday spaces."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Reference image description",
      "default": "Colourful design objects arranged on a sunlit table"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Bottom link label",
      "default": "Meet your match"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Bottom link"
    },
    {
      "type": "checkbox",
      "id": "reference_images",
      "label": "Use reference photos when no image is selected",
      "default": false
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 30,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Mobile heading size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Image darkening",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#DDD9CD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#171514"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "proxima",
          "label": "Proxima Nova"
        },
        {
          "value": "cocogoose",
          "label": "Cocogoose Regular"
        }
      ]
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Height mode",
      "default": "responsive",
      "options": [
        {
          "value": "responsive",
          "label": "Adapt to screen"
        },
        {
          "value": "fixed",
          "label": "Use height sliders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM \u00b7 Opening image"
    }
  ]
}
{% endschema %}