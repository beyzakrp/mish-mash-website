{%- liquid
  assign character_colours = 'showoff:#71253D,player:#CDC167,trickster:#F0541A,helper:#B5D4F4' | split: ','
  assign stock_images = 'mm-reference-story.webp,mm-reference-hero.webp,mm-reference-mobile.webp' | split: ','
-%}
<section class="mm-home" id="mm-{{ section.id }}">
  <div class="mm-cat-wrap mm-pad">
    {%- if section.settings.heading != blank -%}
      <div class="mm-section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="mm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        {%- if section.settings.text_style != 'bold' and section.settings.link_label != blank -%}
          <a class="mm-cat-head-link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="mm-cat-row" data-mm-cat-row>
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_collection = block.settings.collection
          assign cat_title = block.settings.title | default: cat_collection.title
          assign cat_url = cat_collection.url | default: routes.all_products_collection_url
          assign cat_image = block.settings.image | default: cat_collection.featured_image
          assign stock_index = forloop.index0 | modulo: 3
          assign character = block.settings.character
          assign character_key = 'mishmash.' | append: character
          assign accent = '#171514'
          for pair in character_colours
            assign parts = pair | split: ':'
            if parts[0] == character
              assign accent = parts[1]
            endif
          endfor
          assign accent_ink = '#171514'
          if character == 'showoff' or character == 'trickster'
            assign accent_ink = '#FFFFFF'
          endif
        -%}
        <article
          class="mm-cat mm-cat--{{ character }}{% if forloop.first %} is-active{% endif %}"
          style="--mm-accent:{{ accent }};--mm-accent-ink:{{ accent_ink }}"
          {{ block.shopify_attributes }}
        >
          <span class="mm-cat-media" aria-hidden="true">
            {%- if cat_image -%}
              {{ cat_image | image_url: width: 1400 | image_tag: widths: '400,700,1000,1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: '' }}
            {%- else -%}
              <img src="{{ stock_images[stock_index] | asset_url }}" alt="" loading="lazy" width="1000" height="1250">
            {%- endif -%}
          </span>
          <span class="mm-cat-index" aria-hidden="true"></span>
          <img
            class="mm-cat-symbol"
            src="{{ 'mm-symbol-' | append: character | append: '.svg' | asset_url }}"
            alt=""
            width="64"
            height="64"
            loading="lazy"
          >
          <div class="mm-cat-body">
            <span class="mm-cat-character">{{ character_key | t }}</span>
            <h3><a href="{{ cat_url }}" class="mm-cat-link">{{ cat_title | escape }}</a></h3>
            <div class="mm-cat-detail">
              <div>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                <span class="mm-cat-cta" aria-hidden="true">{{ 'mishmash.discover' | t }} <span>{% render 'mm-icon', icon: 'arrow-up-right' %}</span></span>
              </div>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
#mm-{{ section.id }}{--mm-paper:{{ section.settings.background }};--mm-ink:{{ section.settings.text_color }};background:var(--mm-paper);color:var(--mm-ink)}
#mm-{{ section.id }} .mm-pad{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}
#mm-{{ section.id }} .mm-cat-row{height:{{ section.settings.row_height }}px}
@media(max-width:749px){
  #mm-{{ section.id }} .mm-pad{padding-top:{{ section.settings.padding_mobile }}px;padding-bottom:{{ section.settings.padding_mobile }}px}
  #mm-{{ section.id }} .mm-cat-row{height:auto}
}
{%- if section.settings.full_width -%}
#mm-{{ section.id }} .mm-cat-wrap{padding-left:0;padding-right:0}
#mm-{{ section.id }} .mm-cat-wrap .mm-section-head{padding-left:5%;padding-right:5%}
#mm-{{ section.id }} .mm-cat-row{gap:0}
#mm-{{ section.id }} .mm-cat{border-radius:0}
{%- endif -%}
{%- if section.settings.text_style == 'bold' -%}
#mm-{{ section.id }} h2,#mm-{{ section.id }} h3{font-family:'MM Cocogoose','MM Proxima Nova',Arial,sans-serif;font-weight:400;font-synthesis:none}
{%- else -%}
#mm-{{ section.id }} h2,#mm-{{ section.id }} h3{font-family:'MM Proxima Nova',Arial,sans-serif;font-weight:500;letter-spacing:-.01em;text-transform:none}
#mm-{{ section.id }} .mm-cat-wrap{padding-left:{{ section.settings.padding_side }}px;padding-right:{{ section.settings.padding_side }}px}
#mm-{{ section.id }} .mm-cat-wrap .mm-section-head{padding:0;flex-direction:row;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:22px}
#mm-{{ section.id }} .mm-section-head h2{margin:0;font-family:var(--font-heading--family);font-weight:500;font-size:{{ section.settings.heading_size }}px;line-height:1.1;letter-spacing:-.02em}
#mm-{{ section.id }} .mm-cat-head-link{flex:none;font-size:14px;font-weight:500}
#mm-{{ section.id }} .mm-cat-head-link:hover{text-decoration:underline;text-underline-offset:3px}
#mm-{{ section.id }} .mm-cat-row{gap:{{ section.settings.card_gap }}px}
#mm-{{ section.id }} .mm-cat{border-radius:0}
#mm-{{ section.id }} .mm-cat h3,#mm-{{ section.id }} .mm-cat-row:has(.mm-cat:hover,.mm-cat:focus-within) .mm-cat:not(:hover,:focus-within) h3{font-size:{{ section.settings.title_size }}px;line-height:1.2}
#mm-{{ section.id }} .mm-cat{padding:20px}
#mm-{{ section.id }} .mm-cat-character{padding:0;background:none;color:inherit;font-weight:500;font-size:11px;letter-spacing:.06em;margin-bottom:8px;display:inline-flex;align-items:center;gap:6px}
#mm-{{ section.id }} .mm-cat-character:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--mm-accent)}
#mm-{{ section.id }} .mm-cat-detail p{font-size:14px;padding-top:8px;max-width:300px}
#mm-{{ section.id }} .mm-cat-cta{font-weight:500;letter-spacing:.02em;margin-top:10px}
#mm-{{ section.id }} .mm-cat-symbol{width:{{ section.settings.symbol_size }}px}
#mm-{{ section.id }} .mm-cat:after{height:3px}
{%- endif -%}
@media(min-width:750px){
#mm-{{ section.id }} .mm-cat-row .mm-cat:is(:hover,:focus-within){flex-grow:{{ section.settings.hover_growth | divided_by: 10.0 }}}
#mm-{{ section.id }} .mm-cat-row:has(.mm-cat:hover,.mm-cat:focus-within) .mm-cat:not(:hover,:focus-within){flex-grow:{% if section.settings.hover_growth < 20 %}.9{% else %}.8{% endif %}}
}
@media(max-width:749px){#mm-{{ section.id }} .mm-cat.is-active{height:{{ section.settings.mobile_open_height }}px}{%- if section.settings.text_style != 'bold' -%}#mm-{{ section.id }} .mm-cat-wrap{padding-left:{{ section.settings.padding_side | at_most: 16 }}px;padding-right:{{ section.settings.padding_side | at_most: 16 }}px}#mm-{{ section.id }} .mm-section-head h2{font-size:{{ section.settings.heading_mobile }}px}{%- endif -%}}
{% endstyle %}

{% schema %}
{
  "name": "MM · Category row",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "default": "minimal",
      "options": [
        { "value": "minimal", "label": "Minimal (Proxima)" },
        { "value": "bold", "label": "Bold (Cocogoose)" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28,
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Mobile heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Right link label",
      "default": "Shop all",
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Right link",
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "range",
      "id": "padding_side",
      "label": "Side spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Card title size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "range",
      "id": "symbol_size",
      "label": "Symbol size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 44,
      "visible_if": "{{ section.settings.text_style == 'minimal' }}"
    },
    {
      "type": "range",
      "id": "hover_growth",
      "label": "How much the hovered card opens",
      "info": "10 = no growth, 34 = the original large opening.",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_open_height",
      "label": "Mobile open card height",
      "min": 200,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 340
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to start straight with the row."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Desktop height",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#171514"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image, then a stock photo."
        },
        {
          "type": "select",
          "id": "character",
          "label": "Personality symbol",
          "default": "showoff",
          "options": [
            {
              "value": "showoff",
              "label": "The Show-off"
            },
            {
              "value": "player",
              "label": "The Player"
            },
            {
              "value": "trickster",
              "label": "The Trickster"
            },
            {
              "value": "helper",
              "label": "The Helper"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "info": "Shown when the block opens on hover."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM · Category row",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Vase",
            "character": "showoff",
            "text": "Made to be looked at. A sculptural centrepiece that steals the room, with or without flowers."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Lamp",
            "character": "helper",
            "text": "Quietly useful, always there. Soft light for slow evenings and late-night reading."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Clock",
            "character": "player",
            "text": "Time, but make it fun. Bold shapes and colours that turn every glance into a small game."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Candle",
            "character": "trickster",
            "text": "Not quite what it seems. Playful forms that change character once they are lit."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Magnet Frame",
            "character": "player",
            "text": "Swap, stack, rearrange. A frame that lets your memories play musical chairs."
          }
        }
      ]
    }
  ]
}
{% endschema %}
