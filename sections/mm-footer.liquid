{%- liquid
  assign column_count = 0
  for block in section.blocks
    if block.type == 'menu' or block.type == 'social'
      assign column_count = column_count | plus: 1
    endif
  endfor
  assign desktop_columns = section.settings.columns
  if desktop_columns == 0
    assign desktop_columns = column_count | at_least: 1 | at_most: 6
  endif
  assign in_columns = false
-%}
<footer class="mm-home mm-footer{% if section.settings.dividers %} mm-footer--lines{% endif %}" id="mm-{{ section.id }}">
  {%- for block in section.blocks -%}
    {%- assign is_column = false -%}
    {%- if block.type == 'menu' or block.type == 'social' -%}{%- assign is_column = true -%}{%- endif -%}

    {%- if is_column and in_columns == false -%}
      {%- assign in_columns = true -%}
      <mm-footer-columns class="mm-footer__cols" data-accordion="{{ section.settings.mobile_accordion }}">
        <nav class="mm-footer__cols-grid" aria-label="{{ section.settings.nav_label | escape }}">
    {%- elsif is_column == false and in_columns -%}
      {%- assign in_columns = false -%}
        </nav>
      </mm-footer-columns>
    {%- endif -%}

    {%- case block.type -%}
      {%- when 'newsletter' -%}
        <div class="mm-footer__news mm-footer__news--{{ block.settings.layout }}" {{ block.shopify_attributes }}>
          <div class="mm-footer__news-copy">
            {%- if block.settings.eyebrow != blank -%}<p class="mm-footer__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="mm-footer__news-heading">{{ block.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="mm-footer__news-text">{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
          {%- form 'customer', id: 'mm-footer-signup', class: 'mm-footer__news-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="MMFooterEmail-{{ section.id }}" class="mm-footer__sr">{{ 'blocks.email_signup.label' | t }}</label>
            <input
              id="MMFooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ block.settings.placeholder | escape }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="MMFooterMessage-{{ section.id }}"{% endif %}
            >
            <button type="submit" class="mm-footer__news-button">{{ block.settings.button_label | escape }}</button>
            {%- if form.posted_successfully? -%}
              <p class="mm-footer__message" id="MMFooterMessage-{{ section.id }}" role="status">{{ block.settings.success | escape }}</p>
            {%- elsif form.errors -%}
              <p class="mm-footer__message" id="MMFooterMessage-{{ section.id }}" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
        {% style %}
          #mm-{{ section.id }} .mm-footer__news-button{--mm-fb-bg:{{ block.settings.button_background }};--mm-fb-text:{{ block.settings.button_text }};--mm-fb-border:{{ block.settings.button_border | default: 'transparent' }};--mm-fb-hover-bg:{{ block.settings.button_hover_background }};--mm-fb-hover-text:{{ block.settings.button_hover_text }};--mm-fb-border-width:{{ block.settings.button_border_width }}px}
        {% endstyle %}

      {%- when 'menu' -%}
        {%- assign menu = block.settings.menu -%}
        {%- assign column_heading = block.settings.heading | default: menu.title -%}
        {%- if menu.links.size > 0 or request.design_mode -%}
          <details class="mm-footer__col" data-open-mobile="{{ block.settings.open_on_mobile }}" open {{ block.shopify_attributes }}>
            <summary class="mm-footer__col-heading">
              <span>{{ column_heading | default: 'Menu' | escape }}</span>
              <svg class="mm-footer__chevron" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            {%- if menu.links.size > 0 -%}
              <ul class="mm-footer__links" role="list">
                {%- for link in menu.links -%}
                  {%- liquid
                    assign link_title = link.title | downcase
                    assign link_symbol = ''
                    if block.settings.link_symbols
                      if link_title contains 'show-off' or link_title contains 'showoff'
                        assign link_symbol = 'showoff'
                      elsif link_title contains 'player'
                        assign link_symbol = 'player'
                      elsif link_title contains 'trickster'
                        assign link_symbol = 'trickster'
                      elsif link_title contains 'helper'
                        assign link_symbol = 'helper'
                      endif
                    endif
                    assign badge_match = block.settings.badge_link | downcase | strip
                  -%}
                  <li>
                    <a href="{{ link.url }}"{% if link.url contains '://' %}{% unless link.url contains shop.domain %} target="_blank" rel="noopener"{% endunless %}{% endif %}>
                      {%- if link_symbol != blank -%}
                        {%- liquid
                          case link_symbol
                            when 'showoff'
                              assign link_colour = '#970C38'
                            when 'player'
                              assign link_colour = '#CCDB65'
                            when 'trickster'
                              assign link_colour = '#192FDA'
                            else
                              assign link_colour = '#FB7FB0'
                          endcase
                        -%}
                        <span class="mm-footer__link-symbol" style="--mm-symbol-url: url({{ 'mm-symbol-' | append: link_symbol | append: '.svg' | asset_url }}); --mm-symbol-color: {{ link_colour }};" aria-hidden="true"></span>
                      {%- endif -%}
                      <span>{{ link.title | escape }}</span>
                      {%- if badge_match != blank and link_title == badge_match and block.settings.badge_text != blank -%}
                        <span class="mm-footer__badge" style="--mm-badge-bg: {{ block.settings.badge_background }}; --mm-badge-text: {{ block.settings.badge_text_colour }};">{{ block.settings.badge_text | escape }}</span>
                      {%- endif -%}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <p class="mm-footer__empty">Choose a menu for this column in the theme editor.</p>
            {%- endif -%}
          </details>
        {%- endif -%}

      {%- when 'social' -%}
        {%- capture social_links -%}
          {%- if block.settings.instagram != blank -%}<li><a href="{{ block.settings.instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
          {%- if block.settings.pinterest != blank -%}<li><a href="{{ block.settings.pinterest }}" target="_blank" rel="noopener">Pinterest</a></li>{%- endif -%}
          {%- if block.settings.tiktok != blank -%}<li><a href="{{ block.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
          {%- if block.settings.youtube != blank -%}<li><a href="{{ block.settings.youtube }}" target="_blank" rel="noopener">YouTube</a></li>{%- endif -%}
          {%- if block.settings.facebook != blank -%}<li><a href="{{ block.settings.facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
          {%- if block.settings.email != blank -%}<li><a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email_label | default: 'Email us' | escape }}</a></li>{%- endif -%}
        {%- endcapture -%}
        {%- if social_links != blank or request.design_mode -%}
          <details class="mm-footer__col" data-open-mobile="{{ block.settings.open_on_mobile }}" open {{ block.shopify_attributes }}>
            <summary class="mm-footer__col-heading">
              <span>{{ block.settings.heading | escape }}</span>
              <svg class="mm-footer__chevron" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            {%- if social_links != blank -%}
              <ul class="mm-footer__links" role="list">{{ social_links }}</ul>
            {%- else -%}
              <p class="mm-footer__empty">Add your social links in the theme editor.</p>
            {%- endif -%}
          </details>
        {%- endif -%}

      {%- when 'brand' -%}
        <div class="mm-footer__mark" {{ block.shopify_attributes }}>
          {%- liquid
            assign logo_ratio = 1.203
            if block.settings.logo_image != blank
              assign logo_ratio = block.settings.logo_image.aspect_ratio
            endif
            assign mark_units = logo_ratio
            assign mark_gaps = 0
            if block.settings.show_symbols
              assign mark_units = logo_ratio | plus: 4
              assign mark_gaps = 4
            endif
          -%}
          <div class="mm-footer__brand" style="--mm-footer-logo-ratio: {{ logo_ratio }}; --mm-footer-units: {{ mark_units }}; --mm-footer-gaps: {{ mark_gaps }}; --mm-footer-mark-height: {{ block.settings.mark_height }}px; --mm-footer-symbol-gap: {{ block.settings.symbol_gap }}px;">
            <a href="{{ routes.root_url }}" class="mm-footer__logo">
              {%- if block.settings.logo_image != blank -%}
                {{ block.settings.logo_image | image_url: width: 900 | image_tag: alt: shop.name, loading: 'lazy', widths: '300,600,900', sizes: '(min-width: 750px) 300px, 50vw' }}
              {%- else -%}
                <img src="{{ 'mm-logo-white.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="314" height="261" loading="lazy">
              {%- endif -%}
            </a>
            {%- if block.settings.show_symbols -%}
              <ul class="mm-footer__symbols mm-footer__symbols--{{ block.settings.symbol_colour }}{% if block.settings.symbol_motion != 'none' %} mm-footer__symbols--{{ block.settings.symbol_motion }}{% endif %}" role="list" aria-hidden="true">
                {%- assign footer_symbols = 'showoff:#970C38,player:#CCDB65,trickster:#192FDA,helper:#FB7FB0' | split: ',' -%}
                {%- for pair in footer_symbols -%}
                  {%- liquid
                    assign parts = pair | split: ':'
                    assign symbol_image_key = 'symbol_image_' | append: forloop.index
                    assign symbol_image = block.settings[symbol_image_key]
                  -%}
                  <li style="--mm-symbol-url: url({{ 'mm-symbol-' | append: parts[0] | append: '.svg' | asset_url }}); --mm-symbol-color: {{ parts[1] }}; --i: {{ forloop.index0 }};">
                    {%- if symbol_image != blank -%}
                      {{ symbol_image | image_url: width: 400 | image_tag: alt: '', loading: 'lazy', class: 'mm-footer__symbol-image' }}
                    {%- else -%}
                      <span class="mm-footer__symbol"></span>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
          {%- if block.settings.tagline != blank -%}<p class="mm-footer__tagline" style="--mm-footer-tagline: {{ block.settings.tagline_size }}px;">{{ block.settings.tagline | escape | newline_to_br }}</p>{%- endif -%}
        </div>

      {%- when 'legal' -%}
        <div class="mm-footer__legal" {{ block.shopify_attributes }}>
          {%- assign current_year = 'now' | date: '%Y' -%}
          <p class="mm-footer__copyright">{{ block.settings.copyright | default: shop.name | replace: '[year]', current_year | escape }}</p>
          {%- assign legal_menu = block.settings.menu -%}
          {%- if legal_menu.links.size > 0 -%}
            <ul class="mm-footer__policies" role="list">
              {%- for link in legal_menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
            </ul>
          {%- elsif block.settings.show_policies and shop.policies.size > 0 -%}
            <ul class="mm-footer__policies" role="list">
              {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <ul class="mm-footer__payments" role="list">
              {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
    {%- endcase -%}

    {%- if forloop.last and in_columns -%}
        </nav>
      </mm-footer-columns>
    {%- endif -%}
  {%- endfor -%}
</footer>

{% style %}
#mm-{{ section.id }}{--mm-paper:{{ section.settings.background }};--mm-ink:{{ section.settings.text_color }};--mm-accent:{{ section.settings.accent }};--mm-footer-heading:{{ section.settings.heading_colour }};--mm-footer-heading-size:{{ section.settings.heading_size }}px;--mm-footer-link-size:{{ section.settings.link_size }}px;--mm-footer-link-gap:{{ section.settings.link_gap }}px;--mm-footer-col-gap:{{ section.settings.column_gap }}px;--mm-footer-columns:{{ desktop_columns }};--mm-footer-block-gap:{{ section.settings.block_gap }}px;--mm-footer-news-size:{{ section.settings.newsletter_heading_size }}px;background:var(--mm-paper);color:var(--mm-ink);padding:{{ section.settings.padding_top }}px {{ section.settings.padding_side }}% {{ section.settings.padding_bottom }}px}
@media(max-width:749px){#mm-{{ section.id }}{--mm-footer-block-gap:{{ section.settings.block_gap | times: 0.7 | round }}px;padding:{{ section.settings.padding_mobile }}px 20px {{ section.settings.padding_bottom | at_most: 40 }}px}}
{% endstyle %}

{% stylesheet %}
.mm-footer{display:flex;flex-direction:column;gap:var(--mm-footer-block-gap,48px)}
.mm-footer--lines>:not(:last-child):not(.mm-footer__mark){padding-bottom:var(--mm-footer-block-gap,48px);border-bottom:1px solid color-mix(in srgb,var(--mm-ink) 16%,transparent)}
.mm-footer__eyebrow{margin:0!important;font-size:11px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;color:var(--mm-footer-heading)}
.mm-footer__news{display:flex;align-items:center;justify-content:space-between;gap:clamp(24px,4vw,64px)}
.mm-footer__news--stacked{flex-direction:column;align-items:flex-start}
.mm-footer__news-copy{display:grid;gap:10px;min-width:0}
.mm-home .mm-footer__news-heading{margin:0;font-size:var(--mm-footer-news-size,40px);line-height:1.05}
.mm-footer__news-text{font-size:15px;line-height:1.55;opacity:.75;max-width:52ch}
.mm-footer__sr{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
:is(.mm-footer__news-form,.mm-footer__news form){display:flex;flex-wrap:wrap;gap:10px;flex:0 1 520px;min-width:min(100%,320px)}
.mm-footer__news--stacked .mm-footer__sr{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
:is(.mm-footer__news-form,.mm-footer__news form){flex-basis:auto;width:min(100%,520px)}
.mm-footer__news input[type=email]{flex:1 1 220px;min-width:0;min-height:56px;padding:0 22px;border:2px solid color-mix(in srgb,var(--mm-ink) 40%,transparent);border-radius:40px;background:transparent;color:inherit;font:inherit;font-size:15px;outline:none;transition:border-color .25s}
.mm-footer__news input[type=email]::placeholder{color:inherit;opacity:.55}
.mm-footer__news input[type=email]:focus{border-color:var(--mm-ink)}
.mm-footer__news-button{min-height:56px;padding:0 30px;border-radius:40px;border:var(--mm-fb-border-width,3px) solid var(--mm-fb-border);background:var(--mm-fb-bg);color:var(--mm-fb-text);font:inherit;font-size:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background .25s,color .25s,translate .3s}
.mm-footer__news-button:hover{background:var(--mm-fb-hover-bg);color:var(--mm-fb-hover-text);translate:0 -2px}
.mm-footer__message{flex-basis:100%;margin:4px 0 0!important;font-size:13px}
.mm-footer__cols-grid{display:grid;grid-template-columns:repeat(var(--mm-footer-columns,4),minmax(0,1fr));gap:var(--mm-footer-col-gap,40px)}
.mm-footer__col summary{list-style:none}
.mm-footer__col summary::-webkit-details-marker{display:none}
.mm-footer__col-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px;font-size:var(--mm-footer-heading-size,13px);font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--mm-footer-heading);cursor:default;pointer-events:none}
.mm-footer__chevron{display:none;width:14px;height:14px;flex:none;transition:rotate .3s}
.mm-footer__links{display:grid;gap:var(--mm-footer-link-gap,11px);margin:0;padding:0;list-style:none;font-size:var(--mm-footer-link-size,15px)}
.mm-footer__links a{display:inline-flex;align-items:center;gap:10px;color:inherit;text-decoration:none;transition:color .25s}
.mm-footer__links a:hover{color:var(--mm-accent)}
.mm-footer__link-symbol{flex:none;width:1.05em;height:1.05em;background-color:currentColor;-webkit-mask:var(--mm-symbol-url) center/contain no-repeat;mask:var(--mm-symbol-url) center/contain no-repeat;transition:background-color .3s,rotate .6s cubic-bezier(.34,1.56,.64,1)}
.mm-footer__links a:hover .mm-footer__link-symbol{background-color:var(--mm-symbol-color);rotate:90deg}
.mm-footer__badge{padding:3px 8px;border-radius:100px;background:var(--mm-badge-bg,#CCDB65);color:var(--mm-badge-text,#171514);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;line-height:1.3}
.mm-footer__empty{font-size:13px;opacity:.6}
.mm-footer .mm-footer__mark{padding:0}
.mm-footer__tagline{font-size:var(--mm-footer-tagline,30px)!important}
.mm-footer__legal{display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;padding-top:22px;border-top:1px solid color-mix(in srgb,var(--mm-ink) 16%,transparent);font-size:12px}
.mm-footer__legal>p,.mm-footer__legal a{opacity:.75}
.mm-footer__legal a{color:inherit;text-decoration:none}
.mm-footer__legal a:hover{opacity:1;color:var(--mm-accent)}
.mm-footer__policies{display:flex;flex-wrap:wrap;gap:8px 20px;margin:0;padding:0;list-style:none}
.mm-footer__payments{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 0 auto;padding:0;list-style:none}
.mm-footer__payments svg{display:block;width:38px;height:24px}
@media(max-width:989px){.mm-footer__news{flex-direction:column;align-items:stretch}.mm-footer__news :is(.mm-footer__news-form,form){flex-basis:auto}.mm-footer__cols-grid{grid-template-columns:repeat(min(var(--mm-footer-columns,4),2),minmax(0,1fr));row-gap:36px}}
@media(max-width:749px){
  .mm-footer__news{flex-direction:column;align-items:stretch}
  .mm-home .mm-footer__news-heading{font-size:calc(var(--mm-footer-news-size,40px) * .75)}
  .mm-footer__sr{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
:is(.mm-footer__news-form,.mm-footer__news form){flex-basis:auto;min-width:0}
  .mm-footer__news-button{flex:1 1 100%}
  .mm-footer__tagline{font-size:calc(var(--mm-footer-tagline,30px) * .75)!important}
  .mm-footer__payments{margin-left:0}
  .mm-footer--lines>.mm-footer__cols[data-accordion="true"]{padding-bottom:0;border-bottom:0}
  .mm-footer__cols[data-accordion="true"] .mm-footer__cols-grid{display:block}
  .mm-footer:not(.mm-footer--lines) .mm-footer__cols[data-accordion="true"] .mm-footer__cols-grid{border-top:1px solid color-mix(in srgb,var(--mm-ink) 16%,transparent)}
  .mm-footer__cols[data-accordion="true"] .mm-footer__col{border-bottom:1px solid color-mix(in srgb,var(--mm-ink) 16%,transparent)}
  .mm-footer__cols[data-accordion="true"] .mm-footer__col-heading{min-height:56px;margin:0;pointer-events:auto;cursor:pointer}
  .mm-footer__cols[data-accordion="true"] .mm-footer__chevron{display:block}
  .mm-footer__cols[data-accordion="true"] .mm-footer__col[open] .mm-footer__chevron{rotate:180deg}
  .mm-footer__cols[data-accordion="true"] .mm-footer__links{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:12px;padding-bottom:22px}
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('mm-footer-columns')) {
  customElements.define(
    'mm-footer-columns',
    class MMFooterColumns extends HTMLElement {
      connectedCallback() {
        this.query = window.matchMedia('(max-width: 749px)');
        this.onChange = () => this.update();
        this.query.addEventListener('change', this.onChange);
        this.addEventListener('click', (event) => {
          const summary = event.target instanceof Element ? event.target.closest('summary') : null;
          if (summary && !this.isAccordion()) event.preventDefault();
        });
        this.update();
      }

      disconnectedCallback() {
        this.query?.removeEventListener('change', this.onChange);
      }

      isAccordion() {
        return this.dataset.accordion === 'true' && this.query.matches;
      }

      update() {
        for (const column of this.querySelectorAll('details')) {
          column.open = this.isAccordion() ? column.dataset.openMobile === 'true' : true;
        }
      }
    }
  );
}
{% endjavascript %}

{% schema %}
{
  "name": "MM · Footer",
  "class": "mm-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#171514"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "heading_colour",
      "label": "Column heading colour",
      "default": "#FB7FB0"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Link hover colour",
      "default": "#FB7FB0"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "info": "0 fits all menu and social columns in one row.",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Space between columns",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Column heading size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Space between links",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "checkbox",
      "id": "mobile_accordion",
      "label": "Open and close columns on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Menu name for screen readers",
      "default": "Footer"
    },
    {
      "type": "header",
      "content": "Newsletter heading"
    },
    {
      "type": "range",
      "id": "newsletter_heading_size",
      "label": "Newsletter heading size",
