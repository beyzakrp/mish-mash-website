    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#171514"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "proxima",
          "label": "Proxima Nova"
        },
        {
          "value": "cocogoose",
          "label": "Cocogoose Regular"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Mobile heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    }
  ],
  "presets": [
    {
      "name": "MM · Personality cards",
      "blocks": [
        {
          "type": "personality",
          "settings": {
            "character": "showoff",
            "heading": "The Show-off",
            "description": "Just looks good.",
            "background": "#1E6448",
            "text_color": "#FFFFFF",
            "symbol_filter": "brightness(0) invert(1)"
          }
        },
        {
          "type": "personality",
          "settings": {
            "character": "player",
            "heading": "The Player",
            "description": "Touch. Play. Combine.",
            "background": "#F37400",
            "text_color": "#171514",
            "symbol_filter": "brightness(0)"
          }
        },
        {
          "type": "personality",
          "settings": {
            "character": "trickster",
            "heading": "The Trickster",
            "description": "Small surprise. Big joy.",
            "background": "#4CA7FF",
            "text_color": "#171514",
            "symbol_filter": "brightness(0)"
          }
        },
        {
          "type": "personality",
          "settings": {
            "character": "helper",
            "heading": "The Helper",
            "description": "Looks good. Works too.",
            "background": "#FF6EA7",
            "text_color": "#171514",
            "symbol_filter": "brightness(0)"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "personality",
      "name": "Personality card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Show-off"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Just looks good."
        },
        {
          "type": "select",
          "id": "character",
          "label": "Brand symbol",
          "options": [
            {
              "value": "showoff",
              "label": "Showoff"
            },
            {
              "value": "player",
              "label": "Player"
            },
            {
              "value": "trickster",
              "label": "Trickster"
            },
            {
              "value": "helper",
              "label": "Helper"
            }
          ],
          "default": "showoff"
