<section class="mm-home" id="mm-{{ section.id }}">
  <div class="mm-personalities mm-pad" id="{{ section.settings.anchor | default: section.id | handleize }}">
    <div class="mm-section-head"><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.intro | escape }}</p></div>
    <div class="mm-persona-list">
      {% for block in section.blocks %}
        {% assign character = block.settings.character %}
        <a class="mm-persona mm-persona--{{ character }}" href="{{ block.settings.link | default: block.settings.collection.url | default: collections[character].url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }} style="--mm-accent:{{ block.settings.background }};--mm-accent-ink:{{ block.settings.text_color }};--mm-accent-symbol:{{ block.settings.symbol_filter | default: 'none' }}">
          <span class="mm-persona__index">0{{ forloop.index }}</span>
          <span class="mm-persona__symbol" aria-hidden="true">
            {%- assign symbol_asset = 'mm-symbol-' | append: character | append: '.svg' -%}
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<img src="{{ symbol_asset | asset_url }}" alt="" width="48" height="48" loading="lazy">{%- endif -%}
          </span>
          <span class="mm-persona__name">{{ block.settings.heading | escape }}</span>
          <span class="mm-persona__line">{{ block.settings.description | escape }}</span>
          <span class="mm-persona__cta">{{ 'mishmash.discover' | t }} <span aria-hidden="true">{% render 'mm-icon', icon: 'arrow-up-right' %}</span></span>
        </a>
      {% endfor %}
    </div>
  </div>

</section>

{% style %}
#mm-{{ section.id }}{--mm-paper:{{ section.settings.background }};--mm-ink:{{ section.settings.text_color }};background:var(--mm-paper);color:var(--mm-ink)}
#mm-{{ section.id }} .mm-pad{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}
@media(max-width:749px){#mm-{{ section.id }} .mm-pad{padding-top:{{ section.settings.padding_mobile }}px;padding-bottom:{{ section.settings.padding_mobile }}px}}
{% endstyle %}
{% style %}{% if section.settings.heading_font == 'cocogoose' %}#mm-{{ section.id }} h1,#mm-{{ section.id }} h2,#mm-{{ section.id }} h3{font-family:'MM Cocogoose','MM Proxima Nova',Arial,sans-serif;font-weight:400;font-synthesis:none}{% elsif section.settings.heading_font == 'proxima' %}#mm-{{ section.id }} h1,#mm-{{ section.id }} h2,#mm-{{ section.id }} h3{font-family:'MM Proxima Nova',Arial,sans-serif}{% endif %}{% endstyle %}{% style %}#mm-{{ section.id }} h2{font-size:{{ section.settings.heading_size }}px}@media(max-width:749px){#mm-{{ section.id }} h2{font-size:{{ section.settings.heading_mobile }}px}}{% endstyle %}
{% schema %}
{
  "name": "MM · Personality list",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Four personalities.\nOne happy home."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Description",
      "default": "Which one feels like you?"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor name",
      "default": "personalities"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#171514"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "proxima",
          "label": "Proxima Nova"
        },
        {
          "value": "cocogoose",
          "label": "Cocogoose Regular"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Mobile heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    }
  ],
  "presets": [
    {
      "name": "MM · Personality list",
      "blocks": [
        {
          "type": "personality",
          "settings": {
            "character": "showoff",
            "heading": "The Show-off",
            "description": "Just looks good.",
            "background": "#970C38",
            "text_color": "#FFFFFF",
            "symbol_filter": "brightness(0) invert(1)"
          }
        },
        {
          "type": "personality",
          "settings": {
            "character": "player",
            "heading": "The Player",
            "description": "Touch. Play. Combine.",
            "background": "#CCDB65",
            "text_color": "#171514",
            "symbol_filter": "brightness(0)"
          }
        },
        {
          "type": "personality",
          "settings": {
            "character": "trickster",
            "heading": "The Trickster",
            "description": "Small surprise. Big joy.",
            "background": "#192FDA",
            "text_color": "#171514",
            "symbol_filter": "brightness(0)"
          }
        },
        {
          "type": "personality",
          "settings": {
            "character": "helper",
            "heading": "The Helper",
            "description": "Looks good. Works too.",
            "background": "#FB7FB0",
            "text_color": "#171514",
            "symbol_filter": "brightness(0)"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "personality",
      "name": "Personality card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Show-off"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Just looks good."
        },
        {
          "type": "select",
          "id": "character",
          "label": "Brand symbol",
          "options": [
            {
              "value": "showoff",
              "label": "Showoff"
            },
            {
              "value": "player",
              "label": "Player"
            },
            {
              "value": "trickster",
              "label": "Trickster"
            },
            {
              "value": "helper",
              "label": "Helper"
            }
          ],
          "default": "showoff"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "select",
          "id": "symbol_filter",
          "label": "Symbol on hover",
          "options": [
            {
              "value": "none",
              "label": "Original colours"
            },
            {
              "value": "brightness(0)",
              "label": "Black"
            },
            {
              "value": "brightness(0) invert(1)",
              "label": "White"
            }
          ],
          "default": "brightness(0)"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Hover colour",
          "default": "#970C38"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Hover text colour",
          "default": "#FFFFFF"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (if link is empty)"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
