{% doc %}
  Loads the mish-mash font families and applies the selected heading family.
{% enddoc %}
{%- if settings.mm_heading_font == 'cocogoose' -%}
  {{ 'mm-cocogoose-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}
<style>
  @font-face{font-family:'MM Proxima Nova';unicode-range:U+0020,U+002C,U+002E,U+0030-0033,U+0035-003B,U+003F,U+0041-005A,U+0061-007A;src:url('{{ 'mm-proxima-regular.woff2' | asset_url }}') format('woff2');font-weight:400;font-style:normal;font-display:swap}
  @font-face{font-family:'MM Proxima Nova';unicode-range:U+0020,U+002C,U+002E,U+0030-0033,U+0035-003B,U+003F,U+0041-005A,U+0061-007A;src:url('{{ 'mm-proxima-semibold.woff2' | asset_url }}') format('woff2');font-weight:600;font-style:normal;font-display:swap}
  @font-face{font-family:'MM Proxima Nova';unicode-range:U+0020,U+002C,U+002E,U+0030-0033,U+0035-003B,U+003F,U+0041-005A,U+0061-007A;src:url('{{ 'mm-proxima-bold.woff2' | asset_url }}') format('woff2');font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:'MM Proxima Nova';unicode-range:U+0020,U+002C,U+002E,U+0030-0033,U+0035-003B,U+003F,U+0041-005A,U+0061-007A;src:url('{{ 'mm-proxima-extrabold.woff2' | asset_url }}') format('woff2');font-weight:800;font-style:normal;font-display:swap}
  @font-face{font-family:'MM Proxima Nova';unicode-range:U+0020,U+002C,U+002E,U+0030-0033,U+0035-003B,U+003F,U+0041-005A,U+0061-007A;src:url('{{ 'mm-proxima-regularit.woff2' | asset_url }}') format('woff2');font-weight:400;font-style:italic;font-display:swap}
  @font-face{font-family:'MM Cocogoose';unicode-range:U+0020-0024,U+0026-002F,U+003A-007E,U+00A0-012F,U+0131-017F,U+2010-2027,U+2030-203A,U+20AC,U+2122,U+2190-2199;src:url('{{ 'mm-cocogoose-regular.woff2' | asset_url }}') format('woff2');font-weight:400;font-style:normal;font-display:swap}
  :root,body{
    --font-body--family:'MM Proxima Nova',Arial,sans-serif;
    --font-body--weight:400;
    --font-subheading--family:'MM Proxima Nova',Arial,sans-serif;
    --font-subheading--weight:600;
    --font-accent--family:'MM Proxima Nova',Arial,sans-serif;
    --font-accent--weight:600;
    --font-heading--family:{% if settings.mm_heading_font == 'cocogoose' %}'MM Cocogoose','MM Proxima Nova'{% else %}'MM Proxima Nova'{% endif %},Arial,sans-serif;
    --font-heading--weight:{% if settings.mm_heading_font == 'cocogoose' %}400{% else %}700{% endif %};
  }
  .mm-font-cocogoose{font-family:'MM Cocogoose','MM Proxima Nova',Arial,sans-serif;font-weight:400;font-synthesis:none}
  {% if settings.mm_heading_font == 'cocogoose' %}
    body .mm-home h1,body .mm-home h2,body .mm-home h3{font-weight:400;font-synthesis:none;letter-spacing:-.025em}
  {% endif %}
</style>

